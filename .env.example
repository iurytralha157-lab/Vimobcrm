NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VIMOB_API_URL=http://localhost:8081

# E2E tests (use local Supabase by default; copy values from `supabase status -o env`)
E2E_BASE_URL=http://127.0.0.1:3000
E2E_VIMOB_API_URL=http://127.0.0.1:8081
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_SUPABASE_JWT_SECRET=
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Portainer / Docker
VIMOB_WEB_IMAGE=ghcr.io/iurytralha157-lab/vimob-crm-web@sha256:<digest>
VIMOB_API_IMAGE=ghcr.io/iurytralha157-lab/vimob-crm-api@sha256:<digest>
WEB_PORT=3000
API_PUBLIC_PORT=18081
VIMOB_INTERNAL_API_URL=http://api:8081
TRAEFIK_NETWORK=public
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencryptresolver
VIMOB_WEB_DOMAIN=app.vimobcrm.com.br
VIMOB_API_DOMAIN=api.vimobcrm.com.br
NEXT_PUBLIC_SITE_URL=https://app.vimobcrm.com.br
APP_PUBLIC_URL=https://app.vimobcrm.com.br
VIMOB_API_URL=https://api.vimobcrm.com.br

# Vimob API
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8081
API_LOG_LEVEL=info
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_PROJECT_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
DATABASE_URL=
DATABASE_MAX_CONNS=8
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=2m
DATABASE_HEALTH_TIMEOUT=3s
DATABASE_STARTUP_RETRY_TIMEOUT=180s
DATABASE_STARTUP_RETRY_INTERVAL=5s

RESEND_API_KEY=
RESEND_FROM_EMAIL=Vimob CRM <naoresponde@vimobcrm.com.br>
RESEND_REPLY_TO=contato@vimobcrm.com.br
RESEND_WEBHOOK_SECRET=
EMAIL_ASSET_BASE_URL=https://vimobcrm.com.br
SUPPORT_EMAIL=contato@vimobcrm.com.br

# Web Push (VAPID). The API validates the pair and serves the public key at runtime.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:contato@vimobcrm.com.br

# Native app push (Firebase Cloud Messaging HTTP v1).
# Prefer a compact/base64 service account JSON secret in FCM_SERVICE_ACCOUNT_JSON.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

EMAIL_INTERNAL_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI / Vimob AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=cedar
AI_AUTOREPLY_TOKEN=

ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3

EVOLUTION_GO_API_URL=
EVOLUTION_GO_API_KEY=
# Receptor interno da Edge Function. Somente a API Go o chama, com token em header.
EVOLUTION_GO_WEBHOOK_URL=
# Callback obrigatorio do provedor. Nunca inclua token/apikey na URL.
EVOLUTION_GO_BACKEND_WEBHOOK_URL=https://api.vimobcrm.com.br/v1/whatsapp/webhook/evolution-go
# edge (padrao seguro), native_fallback (backend com fallback) ou native (somente apos canario completo)
WHATSAPP_WEBHOOK_PROCESSOR_MODE=edge
# Controla apenas o processador nativo e advanced settings; a URL segura da API e aplicada a todas as sessoes.
# Canario: 13eea7e8-a74f-4bfb-bb36-024e3d26ccc9 | * libera o processador nativo para todas.
WHATSAPP_WEBHOOK_ROLLOUT_SESSION_IDS=
WHATSAPP_AI_WORKER_ENABLED=true
WHATSAPP_AI_WORKER_INTERVAL=1m
WHATSAPP_AI_FOLLOW_UP_WORKER_ENABLED=true
WHATSAPP_AI_FOLLOW_UP_WORKER_INTERVAL=10m
WHATSAPP_OUTBOX_WORKER_ENABLED=true
WHATSAPP_OUTBOX_WORKER_INTERVAL=2s
WHATSAPP_OUTBOX_WORKER_BATCH=10
WHATSAPP_WEBHOOK_WORKER_ENABLED=true
WHATSAPP_WEBHOOK_WORKER_INTERVAL=2s
WHATSAPP_WEBHOOK_WORKER_BATCH=10
WHATSAPP_MEDIA_WORKER_ENABLED=false
WHATSAPP_MEDIA_WORKER_INTERVAL=2s
WHATSAPP_MEDIA_WORKER_LEASE=5m
WHATSAPP_MEDIA_WORKER_SESSION_IDS=
WHATSAPP_SESSION_SUPERVISOR_ENABLED=true
WHATSAPP_SESSION_SUPERVISOR_INITIAL_DELAY=30s
WHATSAPP_SESSION_SUPERVISOR_INTERVAL=1m
WHATSAPP_SESSION_SUPERVISOR_BATCH=10
# Empty means status synchronization only. Start provider recovery with a UUID canary.
WHATSAPP_SESSION_SUPERVISOR_RECOVERY_SESSION_IDS=

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://seu-projeto.supabase.co/functions/v1/google-calendar-oauth/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://seu-projeto.supabase.co/functions/v1/google-calendar-webhook
GOOGLE_CALENDAR_POST_CONNECT_REDIRECT_URL=https://app.vimobcrm.com.br/settings?tab=integrations
GOOGLE_CALENDAR_CRON_SECRET=
