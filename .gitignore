/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.validation-tests/
/test-results/
/playwright-report/
/blob-report/
/tests/e2e/.auth/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build
/bin
*.exe
*.test
coverage.out

# misc
.DS_Store
*.pem
.codex/
.tmp/
.CLAUDE_SYSTEM_PROMPT.md
/reports/
supabase/.temp/
