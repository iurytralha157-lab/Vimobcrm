# Mescle estes valores no .env operacional da stack oficial do Supabase.
# Nunca versione SMTP_PASS nem substitua uma allowlist existente sem readback.
AUTH_EMAIL_TEMPLATES_DIR=/opt/supabase/docker/volumes/templates
SMTP_ADMIN_EMAIL=naoresponde@vimobcrm.com.br
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME=Vimob CRM
SITE_URL=https://app.vimobcrm.com.br
ADDITIONAL_REDIRECT_URLS=https://app.vimobcrm.com.br/reset-password,https://app.vimobcrm.com.br/login?emailConfirmation=success

# Optional docker-compose.vimob-auth-rate-limits.yml overlay. Choose values
# only after checking the active gateway's client IP header and normal traffic.
# The header must be replaced by the gateway, never accepted from a client.
AUTH_RATE_LIMIT_TRUSTED_HEADER=
AUTH_RATE_LIMIT_TOKEN_REFRESH=
AUTH_RATE_LIMIT_EMAIL_SENT=
AUTH_RATE_LIMIT_VERIFY=
