+func celpQ(num, den []float32, l int, q []float32) {
+	// Source of truth: https://github.com/oxidezap/whatsapp-rust/blob/ed12f359a086b28e807ba236f0977af1000859fe/wacore/src/voip/mlow/smpl_celp.rs#L303-L307
+	for i := 0; i < l; i++ {
