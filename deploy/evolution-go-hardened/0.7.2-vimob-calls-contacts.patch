@@ -0,0 +1,41 @@
+package whatsmeow_service
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestVoiceRecordingRetentionKeepsRecentAndDeletesExpired(t *testing.T) {
+	root := t.TempDir()
+	oldDir := recordingDirectory(root, "instance", "old")
+	newDir := recordingDirectory(root, "instance", "new")
+	now := time.Now()
+	for _, dir := range []string{oldDir, newDir} {
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+		for _, channel := range []string{"incoming", "outgoing"} {
+			if err := os.WriteFile(filepath.Join(dir, channel+".wav"), []byte("recorded"), 0600); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	old := now.Add(-8 * 24 * time.Hour)
+	for _, channel := range []string{"incoming", "outgoing"} {
+		if err := os.Chtimes(filepath.Join(oldDir, channel+".wav"), old, old); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.Chtimes(oldDir, old, old); err != nil {
+		t.Fatal(err)
+	}
+	cleanExpiredVoiceRecordings(root, 7*24*time.Hour, now)
+	if _, err := os.Stat(oldDir); !os.IsNotExist(err) {
+		t.Fatalf("expired recording directory still exists: %v", err)
+	}
+	if _, err := os.Stat(newDir); err != nil {
+		t.Fatalf("recent recording deleted: %v", err)
+	}
+}
