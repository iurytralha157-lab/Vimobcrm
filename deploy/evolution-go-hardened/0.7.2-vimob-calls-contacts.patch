+func testEngineWithOutgoingCall() (*engine, *Call) {
+	c := &Client{}
+	c.eng = newEngine(c)
+	call := &Call{eng: c.eng, id: "CID", peer: peerJID(), phase: CallPhaseCalling}
+	c.eng.calls["CID"] = &engineCall{
