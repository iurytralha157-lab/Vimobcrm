index 0000000..1f50aee
--- /dev/null
+++ b/pkg/call/handler/call_contract_test.go
@@ -0,0 +1,44 @@
+package call_handler
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	call_service "github.com/evolution-foundation/evolution-go/pkg/call/service"
+	instance_model "github.com/evolution-foundation/evolution-go/pkg/instance/model"
+	whatsmeow_service "github.com/evolution-foundation/evolution-go/pkg/whatsmeow/service"
+	"github.com/gin-gonic/gin"
+)
+
+type rejectContractService struct {
+	call_service.CallService
+	gotInstance string
+	gotCallID   string
+}
+
+func (service *rejectContractService) Reject(instanceID, callID string) (*whatsmeow_service.VoiceCallView, error) {
+	service.gotInstance, service.gotCallID = instanceID, callID
+	return &whatsmeow_service.VoiceCallView{CallID: callID, PeerJID: "5511999999999@s.whatsapp.net", Direction: "incoming", State: "reject_pending"}, nil
+}
+
+func TestRejectReturnsManagedCallIdentityAndPendingState(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	service := &rejectContractService{}
+	router := gin.New()
+	router.POST("/call/reject", func(ctx *gin.Context) {
+		ctx.Set("instance", &instance_model.Instance{Id: "instance"})
+		NewCallHandler(service).RejectCall(ctx)
+	})
+	request := httptest.NewRequest(http.MethodPost, "/call/reject", strings.NewReader(`{"callId":"provider-call"}`))
+	request.Header.Set("Content-Type", "application/json")
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, request)
+	if response.Code != http.StatusOK || service.gotInstance != "instance" || service.gotCallID != "provider-call" {
+		t.Fatalf("response=%d, instance=%q, callID=%q, body=%s", response.Code, service.gotInstance, service.gotCallID, response.Body.String())
+	}
+	if !strings.Contains(response.Body.String(), `"callId":"provider-call"`) || !strings.Contains(response.Body.String(), `"state":"reject_pending"`) {
+		t.Fatalf("managed reject response lost identity or pending state: %s", response.Body.String())
+	}
+}
diff --git a/pkg/call/handler/call_handler.go b/pkg/call/handler/call_handler.go
index 550c339..8fdcc67 100644
--- a/pkg/call/handler/call_handler.go
+++ b/pkg/call/handler/call_handler.go
@@ -1,15 +1,165 @@
 package call_handler
 
 import (
+	"context"
+	"errors"
 	"net/http"
+	"time"
 
 	call_service "github.com/evolution-foundation/evolution-go/pkg/call/service"
 	instance_model "github.com/evolution-foundation/evolution-go/pkg/instance/model"
+	whatsmeow_service "github.com/evolution-foundation/evolution-go/pkg/whatsmeow/service"
 	"github.com/gin-gonic/gin"
 )
 
 type CallHandler interface {
 	RejectCall(ctx *gin.Context)
+	Capabilities(ctx *gin.Context)
+	Start(ctx *gin.Context)
+	Accept(ctx *gin.Context)
+	End(ctx *gin.Context)
+	Recording(ctx *gin.Context)
+	Media(ctx *gin.Context)
+}
+
+type startRequest struct {
+	PeerJID string `json:"peerJid" binding:"required"`
+}
+
+type callIDRequest struct {
+	CallID string `json:"callId" binding:"required"`
+}
+
+const voiceMediaTokenContextKey = "voice_media_token"
+
+// RedactMediaToken must be installed before Gin's logger and recovery handlers.
+// Both can otherwise print the WebSocket ticket from the query string.
+func RedactMediaToken(ctx *gin.Context) {
+	if ctx.Request.URL.Path == "/call/media" {
+		ctx.Set(voiceMediaTokenContextKey, ctx.Query("token"))
+		ctx.Request.URL.RawQuery = ""
+		ctx.Request.RequestURI = ctx.Request.URL.Path
+	}
+	ctx.Next()
+}
+
+func authenticatedInstance(ctx *gin.Context) *instance_model.Instance {
+	value, exists := ctx.Get("instance")
+	instance, ok := value.(*instance_model.Instance)
+	if !exists || !ok || instance == nil || instance.Id == "" {
+		return nil
+	}
+	return instance
+}
+
+func writeCallError(ctx *gin.Context, err error) {
+	switch {
+	case errors.Is(err, whatsmeow_service.ErrVoiceCallsDisabled):
+		ctx.JSON(http.StatusNotImplemented, gin.H{"error": "voice_calls_disabled"})
+	case errors.Is(err, whatsmeow_service.ErrVoiceCallUnavailable):
+		ctx.JSON(http.StatusServiceUnavailable, gin.H{"error": "voice_call_unavailable"})
+	case errors.Is(err, whatsmeow_service.ErrVoiceCallBusy), errors.Is(err, whatsmeow_service.ErrVoiceCallMediaInUse):
+		ctx.JSON(http.StatusConflict, gin.H{"error": "voice_call_busy"})
+	case errors.Is(err, whatsmeow_service.ErrVoiceCallNotFound):
+		ctx.JSON(http.StatusNotFound, gin.H{"error": "voice_call_not_found"})
+	case errors.Is(err, whatsmeow_service.ErrVoiceCallInvalidPeer):
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": "invalid_voice_peer"})
+	default:
+		ctx.JSON(http.StatusBadGateway, gin.H{"error": "voice_call_provider_failed"})
+	}
+}
+
+func (g *callHandler) Capabilities(ctx *gin.Context) {
+	instance := authenticatedInstance(ctx)
+	if instance == nil {
+		ctx.JSON(http.StatusUnauthorized, gin.H{"error": "instance_not_authorized"})
+		return
+	}
+	ctx.JSON(http.StatusOK, g.callService.Capabilities(instance.Id))
+}
+
+func (g *callHandler) Start(ctx *gin.Context) {
+	instance := authenticatedInstance(ctx)
+	if instance == nil {
+		ctx.JSON(http.StatusUnauthorized, gin.H{"error": "instance_not_authorized"})
+		return
+	}
+	ctx.Request.Body = http.MaxBytesReader(ctx.Writer, ctx.Request.Body, 2048)
+	var request startRequest
+	if err := ctx.ShouldBindJSON(&request); err != nil {
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": "invalid_voice_call_request"})
+		return
+	}
+	requestCtx, cancel := context.WithTimeout(ctx.Request.Context(), 20*time.Second)
+	defer cancel()
+	view, err := g.callService.Start(requestCtx, instance.Id, request.PeerJID)
+	if err != nil {
