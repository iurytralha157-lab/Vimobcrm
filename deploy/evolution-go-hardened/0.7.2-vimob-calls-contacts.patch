diff --git a/pkg/whatsmeow/service/voice_calls.go b/pkg/whatsmeow/service/voice_calls.go
new file mode 100644
index 0000000..63a151e
--- /dev/null
+++ b/pkg/whatsmeow/service/voice_calls.go
@@ -0,0 +1,469 @@
+package whatsmeow_service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	instance_model "github.com/evolution-foundation/evolution-go/pkg/instance/model"
+	"github.com/purpshell/meowcaller"
+)
+
+var (
+	ErrVoiceCallsDisabled    = errors.New("voice calls are not enabled for this instance")
+	ErrVoiceCallUnavailable  = errors.New("voice call session is not connected")
+	ErrVoiceCallBusy         = errors.New("another voice call is active for this instance")
+	ErrVoiceCallNotFound     = errors.New("voice call is not active")
+	ErrVoiceCallInvalidPeer  = errors.New("invalid voice call peer")
+	ErrVoiceCallMediaInUse   = errors.New("voice call media is already attached")
+	ErrVoiceCallMediaInvalid = errors.New("voice call media token is invalid")
+)
+
+// VoiceCallView is the public, provider-independent control result. The
+// provider call ID is stable across signaling, media, recordings and CRM history.
+type VoiceCallView struct {
+	CallID     string    `json:"callId"`
+	PeerJID    string    `json:"peerJid"`
+	Direction  string    `json:"direction"`
+	State      string    `json:"state"`
+	OccurredAt time.Time `json:"occurredAt"`
+}
+
+type VoiceCallCapabilities struct {
+	Version     int  `json:"version"`
+	Calls       bool `json:"calls"`
+	ContactSave bool `json:"contactSave"`
+	Recording   bool `json:"recording"`
+	Media       bool `json:"media"`
+}
+
+type voiceCallManager struct {
+	mu      sync.Mutex
+	runtime *clientRuntimeGeneration
+	service *whatsmeowService
+	caller  *meowcaller.Client
+	calls   map[string]*liveVoiceCall
+	placing bool
+	closed  bool
+}
+
+type liveVoiceCall struct {
+	mu            sync.Mutex
+	call          *meowcaller.Call
+	manager       *voiceCallManager
+	view          VoiceCallView
+	media         *voiceMediaBridge
+	recording     *voiceRecording
+	ended         bool
+	terminalTimer *time.Timer
+}
+
+const voiceTerminalConfirmationTimeout = 30 * time.Second
+
+func (w whatsmeowService) voiceCallConfigured(instanceID string) bool {
+	return w.config != nil && w.config.CallsEnabled && w.config.CallsInstanceIDs[instanceID]
+}
+
+func (w whatsmeowService) newVoiceCallManager(runtime *clientRuntimeGeneration) (manager *voiceCallManager, err error) {
+	if runtime == nil || runtime.client == nil || !w.voiceCallConfigured(runtime.instanceId) {
+		return nil, ErrVoiceCallsDisabled
+	}
+	if len(w.config.CallsMediaHMACSecret) < 32 || len(w.config.CallsMediaOrigins) == 0 || w.config.CallsRecordingDir == "" {
+		return nil, errors.New("calls require a 32-byte media secret, explicit browser origins and a private recording directory")
+	}
+	if err := os.MkdirAll(w.config.CallsRecordingDir, 0700); err != nil {
+		return nil, fmt.Errorf("recording directory: %w", err)
+	}
+	if err := os.Chmod(w.config.CallsRecordingDir, 0700); err != nil {
+		return nil, fmt.Errorf("recording directory permissions: %w", err)
+	}
+	if w.recordingCleanupOnce != nil {
+		w.recordingCleanupOnce.Do(func() {
+			go cleanVoiceRecordingLoop(w.config.CallsRecordingDir, w.config.CallsRecordingRetention)
+		})
+	}
+	manager = &voiceCallManager{runtime: runtime, service: &w, calls: make(map[string]*liveVoiceCall)}
+	// The pinned meowcaller revision uses the same whatsmeow module as Evo, but
+	// reaches an unexported node handler. A panic here must not take messaging
+	// offline. The feature remains off unless the canary is explicitly listed.
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			manager = nil
+			err = fmt.Errorf("meowcaller hook initialization: %v", recovered)
+		}
+	}()
+	manager.caller = meowcaller.NewClient(runtime.client)
+	manager.caller.OnIncomingCall(manager.onIncoming)
+	return manager, nil
+}
+
+func (w *whatsmeowService) voiceManager(instanceID string) (*voiceCallManager, error) {
+	if !w.voiceCallConfigured(instanceID) || w.instanceStartGate == nil {
+		return nil, ErrVoiceCallsDisabled
+	}
+	runtime, ok := w.instanceStartGate.currentAuthorizedRuntime(instanceID)
+	if !ok || runtime == nil || runtime.voiceCalls == nil || runtime.client == nil || !runtime.client.IsConnected() || !runtime.client.IsLoggedIn() {
+		return nil, ErrVoiceCallUnavailable
+	}
+	return runtime.voiceCalls, nil
+}
+
+func (w *whatsmeowService) VoiceCallCapabilities(instanceID string) VoiceCallCapabilities {
+	capabilities := VoiceCallCapabilities{Version: 1, ContactSave: true}
+	manager, err := w.voiceManager(instanceID)
+	if err == nil && manager != nil {
+		capabilities.Calls = true
+		capabilities.Recording = true
+		capabilities.Media = true
+	}
+	return capabilities
+}
+
+func (w *whatsmeowService) StartVoiceCall(ctx context.Context, instanceID, peerJID string) (*VoiceCallView, error) {
+	manager, err := w.voiceManager(instanceID)
+	if err != nil {
+		return nil, err
+	}
+	return manager.start(ctx, peerJID)
+}
+
+func (w *whatsmeowService) AcceptVoiceCall(instanceID, callID string) (*VoiceCallView, error) {
+	manager, err := w.voiceManager(instanceID)
+	if err != nil {
+		return nil, err
+	}
+	return manager.control(callID, "accept")
+}
+
+func (w *whatsmeowService) RejectVoiceCall(instanceID, callID string) (*VoiceCallView, error) {
+	manager, err := w.voiceManager(instanceID)
+	if err != nil {
+		return nil, err
+	}
+	return manager.control(callID, "reject")
+}
+
+func (w *whatsmeowService) EndVoiceCall(instanceID, callID string) (*VoiceCallView, error) {
+	manager, err := w.voiceManager(instanceID)
+	if err != nil {
+		return nil, err
+	}
+	return manager.control(callID, "end")
+}
+
+func validVoicePeer(peer string) bool {
+	if strings.TrimSpace(peer) != peer {
+		return false
+	}
+	maxDigits := 15
+	user := peer
+	if strings.HasSuffix(peer, "@s.whatsapp.net") {
+		user = strings.TrimSuffix(peer, "@s.whatsapp.net")
+	} else if strings.HasSuffix(peer, "@lid") {
+		user = strings.TrimSuffix(peer, "@lid")
+		maxDigits = 20
+	} else {
+		user = strings.TrimPrefix(user, "+")
+	}
+	if len(user) < 8 || len(user) > maxDigits {
+		return false
+	}
+	for _, character := range user {
+		if character < '0' || character > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func (manager *voiceCallManager) start(ctx context.Context, peer string) (*VoiceCallView, error) {
+	if !validVoicePeer(peer) {
+		return nil, ErrVoiceCallInvalidPeer
+	}
+	manager.mu.Lock()
+	if manager.closed || !manager.runtime.isActive() {
+		manager.mu.Unlock()
+		return nil, ErrVoiceCallUnavailable
+	}
+	if manager.placing || len(manager.calls) != 0 {
+		manager.mu.Unlock()
+		return nil, ErrVoiceCallBusy
+	}
+	manager.placing = true
+	manager.mu.Unlock()
+	defer func() {
+		manager.mu.Lock()
+		manager.placing = false
+		manager.mu.Unlock()
+	}()
+
+	call, err := manager.caller.Call(ctx, peer)
+	if err != nil {
+		return nil, err
+	}
+	entry, err := manager.attach(call, "outgoing", "outgoing")
+	if err != nil {
+		_ = call.Hangup()
+		call.ReleaseLocal("failed_attach")
+		return nil, err
+	}
+	view := entry.snapshot()
+	return &view, nil
+}
+
+func (manager *voiceCallManager) onIncoming(call *meowcaller.Call) {
+	if call == nil {
+		return
+	}
+	if _, err := manager.attach(call, "incoming", "incoming"); err != nil {
+		if errors.Is(err, ErrVoiceCallBusy) && manager.runtime.isActive() {
+			manager.rejectBusyIncoming(call)
+			return
+		}
+		// Stale runtime: release the provider handle after a best-effort reject.
+		go func() {
+			_ = call.Reject()
+			call.ReleaseLocal("runtime_unavailable")
+		}()
+	}
+}
+
+func (manager *voiceCallManager) rejectBusyIncoming(call *meowcaller.Call) {
+	entry := &liveVoiceCall{
+		call: call, manager: manager,
+		view: VoiceCallView{CallID: call.ID(), PeerJID: call.Peer().String(), Direction: "incoming", State: "incoming", OccurredAt: time.Now().UTC()},
+	}
+	entry.observeEnd()
+	manager.emit(entry.snapshot(), "busy")
+	go func() {
+		if err := call.Reject(); err != nil {
+			entry.finish("outcome_unknown", "busy_reject_send_failed")
+			call.ReleaseLocal("busy_reject_send_failed")
+			return
+		}
+		entry.awaitTerminal("reject_pending", "busy")
+	}()
+}
+
+func (manager *voiceCallManager) attach(call *meowcaller.Call, direction, state string) (*liveVoiceCall, error) {
+	entry := &liveVoiceCall{
+		call:    call,
+		manager: manager,
+		view:    VoiceCallView{CallID: call.ID(), PeerJID: call.Peer().String(), Direction: direction, State: state, OccurredAt: time.Now().UTC()},
+	}
+	manager.mu.Lock()
+	if manager.closed || !manager.runtime.isActive() {
+		manager.mu.Unlock()
+		return nil, ErrVoiceCallUnavailable
+	}
+	if len(manager.calls) != 0 {
+		manager.mu.Unlock()
+		return nil, ErrVoiceCallBusy
+	}
+	manager.calls[call.ID()] = entry
+	manager.mu.Unlock()
+
+	entry.openRecording()
+	entry.attachAudio()
+	call.OnStateChange(func(phase meowcaller.CallPhase) {
+		var next string
+		switch phase {
+		case meowcaller.CallPhaseRinging:
+			next = "ringing"
+		case meowcaller.CallPhaseConnecting:
+			next = "ringing"
+		case meowcaller.CallPhaseActive:
+			next = "active"
+		case meowcaller.CallPhaseEnded:
+			return // OnEnd performs terminal cleanup and recording finalization.
+		default:
+			return
+		}
+		entry.transition(next, "")
+	})
+	entry.observeEnd()
+	manager.emit(entry.snapshot(), "")
+	return entry, nil
+}
+
+func (entry *liveVoiceCall) observeEnd() {
+	entry.call.OnEnd(func(reason string) {
+		state := "ended"
+		if reason == "rejected" {
+			state = "rejected"
+		} else if strings.HasPrefix(reason, "server:") {
+			state = "failed"
+		}
+		entry.finish(state, reason)
+	})
+}
+
+func (entry *liveVoiceCall) snapshot() VoiceCallView {
+	entry.mu.Lock()
+	defer entry.mu.Unlock()
+	return entry.view
+}
+
+func (entry *liveVoiceCall) transition(state, reason string) {
+	entry.mu.Lock()
+	if entry.ended || entry.view.State == state {
+		entry.mu.Unlock()
+		return
+	}
+	entry.view.State = state
+	entry.view.OccurredAt = time.Now().UTC()
+	view := entry.view
+	entry.mu.Unlock()
+	entry.manager.emit(view, reason)
+}
+
+func (entry *liveVoiceCall) finish(state, reason string) {
+	entry.mu.Lock()
+	if entry.ended {
+		entry.mu.Unlock()
+		return
+	}
+	entry.ended = true
+	if entry.terminalTimer != nil {
+		entry.terminalTimer.Stop()
+	}
+	entry.view.State = state
+	entry.view.OccurredAt = time.Now().UTC()
+	view := entry.view
+	entry.mu.Unlock()
+	entry.closeMedia()
+	entry.finishRecording()
+	entry.manager.mu.Lock()
+	if entry.manager.calls[view.CallID] == entry {
+		delete(entry.manager.calls, view.CallID)
+	}
+	entry.manager.mu.Unlock()
+	entry.manager.emit(view, reason)
+}
+
+func (manager *voiceCallManager) control(callID, action string) (*VoiceCallView, error) {
+	manager.mu.Lock()
+	entry := manager.calls[callID]
+	manager.mu.Unlock()
+	if entry == nil || callID == "" {
+		return nil, ErrVoiceCallNotFound
+	}
+	current := entry.snapshot()
+	if current.State == "end_pending" || current.State == "reject_pending" {
+		if (action == "end" && current.State == "end_pending") || (action == "reject" && current.State == "reject_pending") {
+			return &current, nil
+		}
+		return nil, ErrVoiceCallBusy
+	}
+	var err error
+	switch action {
+	case "accept":
+		if current.Direction != "incoming" {
+			return nil, ErrVoiceCallNotFound
+		}
+		err = entry.call.Answer()
+	case "reject":
+		if current.Direction != "incoming" {
+			return nil, ErrVoiceCallNotFound
+		}
+		err = entry.call.Reject()
+	case "end":
+		err = entry.call.Hangup()
+	default:
+		return nil, ErrVoiceCallNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if action == "reject" || action == "end" {
+		state := "end_pending"
+		if action == "reject" {
+			state = "reject_pending"
+		}
+		entry.awaitTerminal(state, "awaiting_remote_confirmation")
+		if action == "end" {
+			entry.closeMedia()
+		}
+	}
+	view := entry.snapshot()
+	return &view, nil
+}
+
+func (entry *liveVoiceCall) awaitTerminal(state, reason string) {
+	entry.transition(state, reason)
+	entry.mu.Lock()
+	if !entry.ended && entry.terminalTimer == nil {
+		entry.terminalTimer = time.AfterFunc(voiceTerminalConfirmationTimeout, func() {
+			entry.finish("outcome_unknown", "remote_confirmation_timeout")
+			entry.call.ReleaseLocal("remote_confirmation_timeout")
+		})
+	}
+	entry.mu.Unlock()
+}
+
+func (manager *voiceCallManager) stop() {
+	manager.mu.Lock()
+	if manager.closed {
+		manager.mu.Unlock()
+		return
+	}
+	manager.closed = true
+	entries := make([]*liveVoiceCall, 0, len(manager.calls))
+	for _, entry := range manager.calls {
+		entries = append(entries, entry)
+	}
+	manager.mu.Unlock()
+	for _, entry := range entries {
+		state := "failed"
+		current := entry.snapshot().State
+		if current == "end_pending" || current == "reject_pending" {
+			state = "outcome_unknown"
+		}
+		entry.finish(state, "instance_stopped")
+		entry.call.ReleaseLocal("instance_stopped")
+	}
+}
+
+func (manager *voiceCallManager) emit(view VoiceCallView, reason string) {
+	instance := manager.runtime.myClient.currentInstance()
+	if instance == nil {
+		return
+	}
+	data := map[string]any{
+		"version": 1, "callId": view.CallID, "instanceId": instance.Id,
+		"instanceName": instance.Name, "peerJid": view.PeerJID,
+		"direction": view.Direction, "state": view.State,
+		"occurredAt": view.OccurredAt.Format(time.RFC3339Nano), "source": "meowcaller",
+	}
+	if reason != "" {
+		data["reason"] = reason
+	}
+	payload, err := json.Marshal(map[string]any{
+		"event": "CallState", "data": data,
+		"instanceId": instance.Id, "instanceName": instance.Name, "instanceToken": instance.Token,
+	})
+	if err != nil {
+		return
+	}
+	// CallState is a canary-only webhook contract. It bypasses the legacy CALL
+	// subscription and cannot be lost because another transport fails first.
+	manager.deliverVoiceWebhook(instance, "CallState", payload)
+}
+
+func (manager *voiceCallManager) deliverVoiceWebhook(instance *instance_model.Instance, event string, payload []byte) {
+	if instance == nil {
+		return
+	}
+	webhookURL := instance.Webhook
+	if webhookURL == "disabled" {
+		webhookURL = ""
+	}
+	if err := manager.service.webhookProducer.Produce(strings.ToLower(instance.Id+"."+event), payload, webhookURL, instance.Id); err != nil {
+		manager.service.loggerWrapper.GetLogger(instance.Id).LogError("[%s] %s webhook enqueue failed: %v", instance.Id, event, err)
+	}
+}
