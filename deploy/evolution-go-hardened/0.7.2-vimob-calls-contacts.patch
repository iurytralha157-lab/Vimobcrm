+)
+
+type fakeSession struct {
+	connected bool
+	sent      []appstate.PatchInfo
+	sendErr   error
+	contact   types.ContactInfo
+	readErr   error
+	readJID   types.JID
+}
+
+func (s *fakeSession) IsConnected() bool { return s.connected }
+func (s *fakeSession) SendAppState(_ context.Context, patch appstate.PatchInfo) error {
+	s.sent = append(s.sent, patch)
+	return s.sendErr
+}
+func (s *fakeSession) GetContact(_ context.Context, jid types.JID) (types.ContactInfo, error) {
+	s.readJID = jid
+	return s.contact, s.readErr
+}
+
+func TestBuildContactSetUsesAccountContactPatch(t *testing.T) {
+	jid := types.NewJID("5511999999999", types.DefaultUserServer)
+	patch := buildContactSet(jid, "Maria Silva")
+	if patch.Type != appstate.WAPatchCriticalUnblockLow || len(patch.Mutations) != 1 {
+		t.Fatalf("unexpected contact patch: %#v", patch)
+	}
+	mutation := patch.Mutations[0]
+	if mutation.Version != 2 || len(mutation.Index) != 2 || mutation.Index[0] != appstate.IndexContact || mutation.Index[1] != jid.String() {
+		t.Fatalf("unexpected contact mutation: %#v", mutation)
+	}
+	action := mutation.Value.GetContactAction()
+	if action == nil || action.GetFullName() != "Maria Silva" || !action.GetSaveOnPrimaryAddressbook() {
+		t.Fatalf("unexpected contact action: %#v", action)
+	}
+}
+
+func TestSaveContactReadsBackFromSameSession(t *testing.T) {
+	session := &fakeSession{connected: true, contact: types.ContactInfo{Found: true, FullName: "Maria Silva"}}
+	service := &Service{getSession: func(id string) (contactSession, bool) {
+		if id != "authorized-instance" {
+			t.Fatalf("unexpected instance: %s", id)
+		}
+		return session, true
+	}}
+
+	result, err := service.Save(context.Background(), "authorized-instance", "+5511999999999", " Maria Silva ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.JID != "5511999999999@s.whatsapp.net" || result.FullName != "Maria Silva" || !result.VerifiedInLinkedSession {
+		t.Fatalf("unexpected save result: %#v", result)
+	}
+	if len(session.sent) != 1 || session.readJID.String() != result.JID {
+		t.Fatalf("patch/readback did not use the same JID: %#v, %s", session.sent, session.readJID)
+	}
+}
+
+func TestSaveContactRejectsInvalidTargetWithoutWriting(t *testing.T) {
+	for _, number := range []string{"", "123", "05511999999999", "5511999999999@g.us", "123456789@lid", "5511 999999999", "+5511999999999:3@s.whatsapp.net"} {
+		t.Run(number, func(t *testing.T) {
+			service := &Service{getSession: func(string) (contactSession, bool) {
+				t.Fatal("invalid number should not resolve a session")
+				return nil, false
+			}}
+			if _, err := service.Save(context.Background(), "instance", number, "Maria"); !errors.Is(err, ErrInvalidNumber) {
+				t.Fatalf("number %q: got %v", number, err)
+			}
+		})
+	}
+}
+
+func TestSaveContactRequiresConfirmedReadback(t *testing.T) {
+	session := &fakeSession{connected: true, contact: types.ContactInfo{Found: true, FullName: "Old Name"}}
+	service := &Service{getSession: func(string) (contactSession, bool) { return session, true }}
+	if _, err := service.Save(context.Background(), "instance", "5511999999999", "New Name"); !errors.Is(err, ErrContactReadback) {
+		t.Fatalf("expected readback failure, got %v", err)
+	}
+	if len(session.sent) != 1 {
+		t.Fatalf("expected one send, got %d", len(session.sent))
+	}
+}
+
+func TestSaveContactRequiresConnectedSession(t *testing.T) {
+	session := &fakeSession{connected: false}
+	service := &Service{getSession: func(string) (contactSession, bool) { return session, true }}
+	if _, err := service.Save(context.Background(), "instance", "5511999999999", "Maria"); !errors.Is(err, ErrInstanceNotConnected) {
+		t.Fatalf("expected disconnected error, got %v", err)
+	}
+	if len(session.sent) != 0 {
+		t.Fatal("sent app state while disconnected")
+	}
+}
