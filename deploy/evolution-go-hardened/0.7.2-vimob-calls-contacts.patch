+package contact_handler
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	contact_service "github.com/evolution-foundation/evolution-go/pkg/contact/service"
+	instance_model "github.com/evolution-foundation/evolution-go/pkg/instance/model"
+	"github.com/gin-gonic/gin"
+)
+
+type fakeSaver struct {
+	instanceID string
+	number     string
+	fullName   string
+	result     *contact_service.SaveResult
+	err        error
+}
+
+func (s *fakeSaver) Save(_ context.Context, instanceID, number, fullName string) (*contact_service.SaveResult, error) {
+	s.instanceID, s.number, s.fullName = instanceID, number, fullName
+	return s.result, s.err
+}
+
+func TestSaveUsesAuthenticatedInstance(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	saver := &fakeSaver{result: &contact_service.SaveResult{JID: "5511999999999@s.whatsapp.net", FullName: "Maria", VerifiedInLinkedSession: true}}
+	router := gin.New()
+	router.Use(func(ctx *gin.Context) {
+		ctx.Set("instance", &instance_model.Instance{Id: "authorized-instance"})
+	})
+	router.POST("/user/contact", NewHandler(saver).Save)
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/user/contact", strings.NewReader(`{"number":"5511999999999","fullName":"Maria"}`)))
+	if response.Code != http.StatusOK || saver.instanceID != "authorized-instance" || saver.number != "5511999999999" || saver.fullName != "Maria" {
+		t.Fatalf("unexpected response or routing: %d %s %#v", response.Code, response.Body.String(), saver)
+	}
+}
+
+func TestSaveRejectsMissingInstanceAndMalformedBody(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	saver := &fakeSaver{}
+	unauthorized := gin.New()
+	unauthorized.POST("/user/contact", NewHandler(saver).Save)
+	response := httptest.NewRecorder()
+	unauthorized.ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/user/contact", strings.NewReader(`{"number":"5511999999999","fullName":"Maria"}`)))
+	if response.Code != http.StatusUnauthorized || saver.instanceID != "" {
+		t.Fatalf("unexpected unauthorized result: %d %s", response.Code, response.Body.String())
+	}
+
+	badBody := gin.New()
+	badBody.Use(func(ctx *gin.Context) { ctx.Set("instance", &instance_model.Instance{Id: "instance"}) })
+	badBody.POST("/user/contact", NewHandler(saver).Save)
+	response = httptest.NewRecorder()
+	badBody.ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/user/contact", strings.NewReader(`{"number":"5511999999999","fullName":"Maria","ignored":true}`)))
+	if response.Code != http.StatusBadRequest || saver.instanceID != "" {
+		t.Fatalf("unexpected invalid-body result: %d %s", response.Code, response.Body.String())
+	}
+}
+
+func TestSaveReportsUnverifiedReadback(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	saver := &fakeSaver{err: errors.Join(contact_service.ErrContactReadback, errors.New("mismatch"))}
+	router := gin.New()
+	router.Use(func(ctx *gin.Context) { ctx.Set("instance", &instance_model.Instance{Id: "instance"}) })
+	router.POST("/user/contact", NewHandler(saver).Save)
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/user/contact", strings.NewReader(`{"number":"5511999999999","fullName":"Maria"}`)))
+	if response.Code != http.StatusBadGateway || !strings.Contains(response.Body.String(), "contact_update_unverified") {
+		t.Fatalf("unexpected readback result: %d %s", response.Code, response.Body.String())
+	}
+}
diff --git a/pkg/contact/service/contact_service.go b/pkg/contact/service/contact_service.go
new file mode 100644
index 0000000..4d3b7c6
--- /dev/null
+++ b/pkg/contact/service/contact_service.go
@@ -0,0 +1,187 @@
+package contact_service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waSyncAction"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/proto"
+)
+
+var (
+	ErrInvalidInstance      = errors.New("invalid instance")
+	ErrInvalidNumber        = errors.New("invalid WhatsApp phone number")
+	ErrInvalidName          = errors.New("invalid contact name")
+	ErrInstanceNotConnected = errors.New("instance is not connected")
+	ErrAppStateSend         = errors.New("contact app state was not confirmed")
+	ErrContactReadback      = errors.New("contact app state readback did not match")
+)
+
+// ClientProvider is satisfied by the running WhatsmeowService. GetCurrentClient
+// resolves only the currently authorized runtime, avoiding stale sessions.
+type ClientProvider interface {
+	GetCurrentClient(instanceID string) (*whatsmeow.Client, bool)
+}
+
+type contactSession interface {
+	IsConnected() bool
+	SendAppState(context.Context, appstate.PatchInfo) error
+	GetContact(context.Context, types.JID) (types.ContactInfo, error)
+}
+
+type whatsmeowSession struct {
+	client *whatsmeow.Client
+}
+
+func (s whatsmeowSession) IsConnected() bool { return s.client.IsConnected() }
+
+func (s whatsmeowSession) SendAppState(ctx context.Context, patch appstate.PatchInfo) error {
+	return s.client.SendAppState(ctx, patch)
+}
+
+func (s whatsmeowSession) GetContact(ctx context.Context, jid types.JID) (types.ContactInfo, error) {
+	if s.client.Store == nil || s.client.Store.Contacts == nil {
+		return types.ContactInfo{}, errors.New("contact store unavailable")
+	}
+	return s.client.Store.Contacts.GetContact(ctx, jid)
+}
+
+type Service struct {
+	provider ClientProvider
+	// getSession is overridden by fakes in package tests only.
+	getSession func(string) (contactSession, bool)
+}
+
+func NewService(provider ClientProvider) *Service {
+	return &Service{provider: provider}
+}
+
+type SaveResult struct {
+	JID                     string `json:"jid"`
+	FullName                string `json:"fullName"`
+	VerifiedInLinkedSession bool   `json:"verifiedInLinkedSession"`
+}
+
+// Save creates or renames a contact in the WhatsApp account paired to this
+// instance. It does not prove that the native phone Contacts app was updated.
+func (s *Service) Save(ctx context.Context, instanceID, number, fullName string) (*SaveResult, error) {
+	if strings.TrimSpace(instanceID) == "" {
+		return nil, ErrInvalidInstance
+	}
+	jid, err := parsePhoneJID(number)
+	if err != nil {
+		return nil, err
+	}
+	name, err := normalizeName(fullName)
+	if err != nil {
+		return nil, err
+	}
+
+	session, ok := s.currentSession(instanceID)
+	if !ok || session == nil || !session.IsConnected() {
+		return nil, ErrInstanceNotConnected
+	}
+
+	if err := session.SendAppState(ctx, buildContactSet(jid, name)); err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrAppStateSend, err)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrContactReadback, err)
+	}
+	if !session.IsConnected() {
+		return nil, ErrInstanceNotConnected
+	}
+	// The instance may have been replaced or logged out while the app state
+	// request was in flight. Never confirm a read from an obsolete runtime.
+	if s.provider != nil {
+		original, ok := session.(whatsmeowSession)
+		if !ok {
+			return nil, ErrContactReadback
+		}
+		active, authorized := s.provider.GetCurrentClient(instanceID)
+		if !authorized || active == nil || active != original.client {
+			return nil, ErrContactReadback
+		}
+	}
+
+	contact, err := session.GetContact(ctx, jid)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrContactReadback, err)
+	}
+	if !contact.Found || contact.FullName != name {
+		return nil, ErrContactReadback
+	}
+	return &SaveResult{JID: jid.String(), FullName: name, VerifiedInLinkedSession: true}, nil
+}
+
+func (s *Service) currentSession(instanceID string) (contactSession, bool) {
+	if s.getSession != nil {
+		return s.getSession(instanceID)
+	}
+	if s.provider == nil {
+		return nil, false
+	}
+	client, ok := s.provider.GetCurrentClient(instanceID)
+	if !ok || client == nil {
+		return nil, false
+	}
+	return whatsmeowSession{client: client}, true
+}
+
+// The contact mutation index requires a phone-number JID. In particular, LIDs,
+// device JIDs, groups, and a + prefixed JID user are not valid here.
+func parsePhoneJID(number string) (types.JID, error) {
+	number = strings.TrimSpace(number)
+	if strings.HasSuffix(number, "@"+types.DefaultUserServer) {
+		number = strings.TrimSuffix(number, "@"+types.DefaultUserServer)
+	}
+	number = strings.TrimPrefix(number, "+")
+	if len(number) < 8 || len(number) > 15 || number[0] == '0' {
+		return types.JID{}, ErrInvalidNumber
+	}
+	for _, digit := range number {
+		if digit < '0' || digit > '9' {
+			return types.JID{}, ErrInvalidNumber
+		}
+	}
+	return types.NewJID(number, types.DefaultUserServer), nil
+}
+
+func normalizeName(fullName string) (string, error) {
+	name := strings.TrimSpace(fullName)
+	if name == "" || !utf8.ValidString(name) || utf8.RuneCountInString(name) > 100 {
+		return "", ErrInvalidName
+	}
+	for _, char := range name {
+		if unicode.IsControl(char) {
+			return "", ErrInvalidName
+		}
+	}
+	return name, nil
+}
+
+// The pinned whatsmeow does not yet expose BuildContact. This SET-only patch
+// matches the proposed upstream builder without replacing the module or adding
+// unsupported contact removal behavior.
+func buildContactSet(jid types.JID, fullName string) appstate.PatchInfo {
+	return appstate.PatchInfo{
+		Type: appstate.WAPatchCriticalUnblockLow,
+		Mutations: []appstate.MutationInfo{{
+			Index:   []string{appstate.IndexContact, jid.String()},
+			Version: 2,
+			Value: &waSyncAction.SyncActionValue{
+				ContactAction: &waSyncAction.ContactAction{
+					FullName:                 proto.String(fullName),
+					SaveOnPrimaryAddressbook: proto.Bool(true),
+				},
+			},
+		}},
+	}
+}
