+
+func (g *callHandler) Recording(ctx *gin.Context) {
+	instance := authenticatedInstance(ctx)
+	if instance == nil {
+		ctx.JSON(http.StatusUnauthorized, gin.H{"error": "instance_not_authorized"})
+		return
+	}
+	path, err := g.callService.RecordingPath(instance.Id, ctx.Query("callId"), ctx.Query("channel"))
+	if err != nil {
+		writeCallError(ctx, err)
+		return
+	}
+	ctx.Header("Cache-Control", "no-store")
+	ctx.Header("Content-Type", "audio/wav")
+	http.ServeFile(ctx.Writer, ctx.Request, path)
+}
+
+func (g *callHandler) Media(ctx *gin.Context) {
+	session, err := g.callService.MediaSession(ctx.GetString(voiceMediaTokenContextKey), ctx.GetHeader("Origin"))
+	if err != nil {
+		ctx.JSON(http.StatusUnauthorized, gin.H{"error": "invalid_voice_media_token"})
+		return
+	}
+	ctx.Header("Cache-Control", "no-store")
+	if err := session.ServeHTTP(ctx.Writer, ctx.Request); err != nil && !ctx.Writer.Written() {
+		writeCallError(ctx, err)
+	}
 }
 
