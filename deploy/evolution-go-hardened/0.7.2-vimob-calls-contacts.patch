+func (g *callHandler) End(ctx *gin.Context) {
+	g.control(ctx, "end")
+}
+
+func (g *callHandler) control(ctx *gin.Context, action string) {
+	instance := authenticatedInstance(ctx)
+	if instance == nil {
+		ctx.JSON(http.StatusUnauthorized, gin.H{"error": "instance_not_authorized"})
+		return
+	}
+	ctx.Request.Body = http.MaxBytesReader(ctx.Writer, ctx.Request.Body, 2048)
+	var request callIDRequest
+	if err := ctx.ShouldBindJSON(&request); err != nil {
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": "invalid_voice_call_request"})
+		return
+	}
+	var view *whatsmeow_service.VoiceCallView
+	var err error
+	if action == "accept" {
+		view, err = g.callService.Accept(instance.Id, request.CallID)
+	} else {
+		view, err = g.callService.End(instance.Id, request.CallID)
+	}
+	if err != nil {
+		writeCallError(ctx, err)
+		return
+	}
+	ctx.JSON(http.StatusOK, view)
