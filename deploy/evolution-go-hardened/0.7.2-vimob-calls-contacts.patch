new file mode 100644
index 0000000..960f620
--- /dev/null
+++ b/pkg/contact/handler/contact_handler.go
@@ -0,0 +1,79 @@
+package contact_handler
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	contact_service "github.com/evolution-foundation/evolution-go/pkg/contact/service"
+	instance_model "github.com/evolution-foundation/evolution-go/pkg/instance/model"
+	"github.com/gin-gonic/gin"
+)
+
+type ContactSaver interface {
+	Save(context.Context, string, string, string) (*contact_service.SaveResult, error)
+}
+
+type Handler struct {
+	service ContactSaver
+}
+
+func NewHandler(service ContactSaver) *Handler {
+	return &Handler{service: service}
+}
+
+type saveRequest struct {
+	Number   string `json:"number"`
+	FullName string `json:"fullName"`
+}
+
+// Save writes a contact to the account of the authenticated Evo instance.
+// Route this behind the existing /user Auth middleware as POST /user/contact.
+func (h *Handler) Save(ctx *gin.Context) {
+	instanceValue, exists := ctx.Get("instance")
+	instance, ok := instanceValue.(*instance_model.Instance)
+	if !exists || !ok || instance == nil || instance.Id == "" {
+		ctx.JSON(http.StatusUnauthorized, gin.H{"error": "instance_not_authorized"})
+		return
+	}
+	if h == nil || h.service == nil {
+		ctx.JSON(http.StatusServiceUnavailable, gin.H{"error": "contact_service_unavailable"})
+		return
+	}
+
+	ctx.Request.Body = http.MaxBytesReader(ctx.Writer, ctx.Request.Body, 2048)
+	decoder := json.NewDecoder(ctx.Request.Body)
+	decoder.DisallowUnknownFields()
+	var request saveRequest
+	if err := decoder.Decode(&request); err != nil {
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": "invalid_contact_request"})
+		return
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": "invalid_contact_request"})
+		return
+	}
+
+	requestCtx, cancel := context.WithTimeout(ctx.Request.Context(), 20*time.Second)
+	defer cancel()
+	result, err := h.service.Save(requestCtx, instance.Id, request.Number, request.FullName)
+	if err != nil {
+		switch {
+		case errors.Is(err, contact_service.ErrInvalidInstance),
+			errors.Is(err, contact_service.ErrInvalidNumber),
+			errors.Is(err, contact_service.ErrInvalidName):
+			ctx.JSON(http.StatusBadRequest, gin.H{"error": "invalid_contact"})
+		case errors.Is(err, contact_service.ErrInstanceNotConnected):
+			ctx.JSON(http.StatusServiceUnavailable, gin.H{"error": "instance_not_connected"})
+		case errors.Is(err, contact_service.ErrContactReadback):
+			ctx.JSON(http.StatusBadGateway, gin.H{"error": "contact_update_unverified"})
+		default:
+			ctx.JSON(http.StatusBadGateway, gin.H{"error": "contact_update_unconfirmed"})
+		}
+		return
+	}
+	ctx.JSON(http.StatusOK, gin.H{"data": result})
+}
