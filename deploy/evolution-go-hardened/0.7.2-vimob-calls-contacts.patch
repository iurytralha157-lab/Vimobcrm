+package whatsmeow_service
+
+import "testing"
+
+func TestValidVoicePeer(t *testing.T) {
+	for _, tc := range []struct {
+		peer string
+		want bool
+	}{
+		{"5511999999999", true},
+		{"5511999999999@s.whatsapp.net", true},
+		{"12345678901234567890@lid", true},
+		{"123@s.whatsapp.net", false},
+		{"abc@s.whatsapp.net", false},
+		{"+12345678@s.whatsapp.net", false},
+		{"12345678@evil.example", false},
+		{" 5511999999999", false},
+	} {
+		if got := validVoicePeer(tc.peer); got != tc.want {
+			t.Errorf("validVoicePeer(%q) = %v, want %v", tc.peer, got, tc.want)
+		}
+	}
+}
diff --git a/pkg/whatsmeow/service/voice_media.go b/pkg/whatsmeow/service/voice_media.go
new file mode 100644
index 0000000..fe6c7c5
--- /dev/null
+++ b/pkg/whatsmeow/service/voice_media.go
@@ -0,0 +1,306 @@
+package whatsmeow_service
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/patrickmn/go-cache"
+	"github.com/purpshell/meowcaller"
+)
+
+const voicePCMBytes = meowcaller.FrameSamples * 2 // 60 ms of s16le mono at 16 kHz
+
+type voiceMediaClaims struct {
+	Version    int    `json:"v"`
+	InstanceID string `json:"instanceId"`
+	CallID     string `json:"callId"`
+	Subject    string `json:"sub"`
+	ExpiresAt  int64  `json:"exp"`
+	Nonce      string `json:"nonce"`
+}
+
+// VoiceCallMediaSession is returned only after a signed, short-lived token
+// passes instance, call, subject, origin, expiry and replay checks.
+type VoiceCallMediaSession struct {
+	entry  *liveVoiceCall
+	origin string
+}
+
+type voiceMediaBridge struct {
+	entry  *liveVoiceCall
+	conn   *websocket.Conn
+	source *voicePCMSource
+	down   chan []byte
+	done   chan struct{}
+	once   sync.Once
+}
+
+type voicePCMSource struct {
+	frames    chan []float32
+	done      chan struct{}
+	once      sync.Once
+	recording *voiceRecording
+}
+
+func (w *whatsmeowService) VoiceCallMediaToken(token, origin string) (*VoiceCallMediaSession, error) {
+	if w.config == nil {
+		return nil, ErrVoiceCallMediaInvalid
+	}
+	claims, err := verifyVoiceMediaClaims(token, origin, w.config.CallsMediaHMACSecret, w.config.CallsMediaOrigins, time.Now())
+	if err != nil {
+		return nil, err
+	}
+	manager, err := w.voiceManager(claims.InstanceID)
+	if err != nil {
+		return nil, ErrVoiceCallMediaInvalid
+	}
+	manager.mu.Lock()
+	entry := manager.calls[claims.CallID]
+	manager.mu.Unlock()
+	if entry == nil || entry.snapshot().CallID != claims.CallID {
+		return nil, ErrVoiceCallMediaInvalid
+	}
+	if !consumeVoiceMediaNonce(w.usedMediaTokens, claims) {
+		return nil, ErrVoiceCallMediaInvalid
+	}
+	return &VoiceCallMediaSession{entry: entry, origin: origin}, nil
+}
+
+func verifyVoiceMediaClaims(token, origin, secret string, allowedOrigins map[string]bool, now time.Time) (voiceMediaClaims, error) {
+	invalid := voiceMediaClaims{}
+	if len(secret) < 32 || !allowedOrigins[origin] || len(token) > 4096 {
+		return invalid, ErrVoiceCallMediaInvalid
+	}
+	parts := strings.Split(token, ".")
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return invalid, ErrVoiceCallMediaInvalid
+	}
+	providedMAC, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil || len(providedMAC) != sha256.Size {
+		return invalid, ErrVoiceCallMediaInvalid
+	}
+	mac := hmac.New(sha256.New, []byte(secret))
+	_, _ = mac.Write([]byte(parts[0]))
+	if !hmac.Equal(providedMAC, mac.Sum(nil)) {
+		return invalid, ErrVoiceCallMediaInvalid
+	}
+	encodedClaims, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil || len(encodedClaims) > 2048 {
+		return invalid, ErrVoiceCallMediaInvalid
+	}
+	decoder := json.NewDecoder(strings.NewReader(string(encodedClaims)))
+	decoder.DisallowUnknownFields()
+	var claims voiceMediaClaims
+	if err := decoder.Decode(&claims); err != nil || decoder.Decode(new(any)) != io.EOF {
+		return invalid, ErrVoiceCallMediaInvalid
+	}
+	nonceBytes, err := base64.RawURLEncoding.DecodeString(claims.Nonce)
+	if claims.Version != 1 || claims.Subject == "" || claims.InstanceID == "" || claims.CallID == "" ||
+		claims.ExpiresAt <= now.Unix() || claims.ExpiresAt > now.Unix()+60 || err != nil || len(nonceBytes) < 16 {
+		return invalid, ErrVoiceCallMediaInvalid
+	}
+	return claims, nil
+}
+
+func consumeVoiceMediaNonce(used *cache.Cache, claims voiceMediaClaims) bool {
+	return used != nil && used.Add(claims.InstanceID+":"+claims.Nonce, true, 2*time.Minute) == nil
+}
+
+func (session *VoiceCallMediaSession) ServeHTTP(writer http.ResponseWriter, request *http.Request) error {
+	if session == nil || session.entry == nil || request.Header.Get("Origin") != session.origin {
+		return ErrVoiceCallMediaInvalid
+	}
+	entry := session.entry
+	bridge := &voiceMediaBridge{
+		entry:  entry,
+		source: &voicePCMSource{frames: make(chan []float32, 8), done: make(chan struct{}), recording: entry.recording},
+		down:   make(chan []byte, 32), done: make(chan struct{}),
+	}
+	entry.mu.Lock()
+	if entry.ended || entry.media != nil {
+		entry.mu.Unlock()
+		return ErrVoiceCallMediaInUse
+	}
+	entry.media = bridge
+	entry.mu.Unlock()
+	defer entry.closeMedia()
+
+	upgrader := websocket.Upgrader{
+		ReadBufferSize:  voicePCMBytes,
+		WriteBufferSize: voicePCMBytes,
+		CheckOrigin: func(r *http.Request) bool {
+			return r.Header.Get("Origin") == session.origin
+		},
+	}
+	conn, err := upgrader.Upgrade(writer, request, http.Header{"Cache-Control": []string{"no-store"}})
+	if err != nil {
+		return err
+	}
+	bridge.conn = conn
+	conn.SetReadLimit(voicePCMBytes)
+	_ = conn.SetReadDeadline(time.Now().Add(voiceMediaIdleTimeout))
+	conn.SetPongHandler(func(string) error {
+		return conn.SetReadDeadline(time.Now().Add(voiceMediaIdleTimeout))
+	})
+	entry.call.Play(bridge.source)
+	go bridge.writeLoop()
+	return readVoicePCMFrames(conn, bridge.source, voiceMediaIdleTimeout)
+}
+
+const voiceMediaIdleTimeout = 60 * time.Second
+
+func readVoicePCMFrames(conn *websocket.Conn, source *voicePCMSource, idleTimeout time.Duration) error {
+	for {
+		kind, data, err := conn.ReadMessage()
+		if err != nil {
+			return nil
+		}
+		if kind != websocket.BinaryMessage || len(data) != voicePCMBytes {
+			return fmt.Errorf("invalid PCM frame: want %d binary bytes", voicePCMBytes)
+		}
+		// Active microphone traffic is the liveness signal. A single deadline
+		// from upgrade would silently cut every call at 60 seconds.
+		_ = conn.SetReadDeadline(time.Now().Add(idleTimeout))
+		source.push(data)
+	}
+}
+
+func (entry *liveVoiceCall) attachAudio() {
+	entry.call.Receive(meowcaller.SinkFunc(func(frame []float32) {
+		entry.mu.Lock()
+		recording := entry.recording
+		bridge := entry.media
+		ended := entry.ended
+		entry.mu.Unlock()
+		if ended {
+			return
+		}
+		if recording != nil {
+			recording.write("incoming", frame)
+		}
+		if bridge == nil {
+			return
+		}
+		pcm := make([]byte, voicePCMBytes)
+		for index, value := range frame {
+			if index >= meowcaller.FrameSamples {
+				break
+			}
+			binary.LittleEndian.PutUint16(pcm[index*2:], uint16(pcmInt16(value)))
+		}
+		select {
+		case <-bridge.done:
+		case bridge.down <- pcm:
+		default: // Drop late audio rather than blocking the WhatsApp receive loop.
+		}
+	}))
+}
+
+func pcmInt16(value float32) int16 {
+	scaled := value * 32768
+	if scaled > 32767 {
+		scaled = 32767
+	} else if scaled < -32768 {
+		scaled = -32768
+	}
+	return int16(scaled)
+}
+
+func (source *voicePCMSource) push(pcm []byte) {
+	frame := make([]float32, meowcaller.FrameSamples)
+	for index := range frame {
+		frame[index] = float32(int16(binary.LittleEndian.Uint16(pcm[index*2:]))) / 32768
+	}
+	select {
+	case <-source.done:
+	case source.frames <- frame:
+	default:
+		// Prefer the newest microphone frame when the browser outruns playout.
+		select {
+		case <-source.frames:
+		default:
+		}
+		select {
+		case <-source.done:
+		case source.frames <- frame:
+		default:
+		}
+	}
+}
+
+func (source *voicePCMSource) ReadFrame() ([]float32, error) {
+	select {
+	case <-source.done:
+		return nil, io.EOF
+	default:
+	}
+	var frame []float32
+	select {
+	case frame = <-source.frames:
+	default:
+		frame = make([]float32, meowcaller.FrameSamples)
+	}
+	if source.recording != nil {
+		source.recording.write("outgoing", frame)
+	}
+	return frame, nil
+}
+
+func (source *voicePCMSource) Close() error {
+	source.once.Do(func() { close(source.done) })
+	return nil
+}
+
+func (bridge *voiceMediaBridge) writeLoop() {
+	ticker := time.NewTicker(20 * time.Second)
+	defer ticker.Stop()
+	defer bridge.close()
+	for {
+		select {
+		case <-bridge.done:
+			return
+		case frame := <-bridge.down:
+			_ = bridge.conn.SetWriteDeadline(time.Now().Add(5 * time.Second))
+			if err := bridge.conn.WriteMessage(websocket.BinaryMessage, frame); err != nil {
+				return
+			}
+		case <-ticker.C:
+			_ = bridge.conn.SetWriteDeadline(time.Now().Add(5 * time.Second))
+			if err := bridge.conn.WriteMessage(websocket.PingMessage, nil); err != nil {
+				return
+			}
+		}
+	}
+}
+
+func (bridge *voiceMediaBridge) close() {
+	bridge.once.Do(func() {
+		close(bridge.done)
+		_ = bridge.source.Close()
+		if bridge.conn != nil {
+			_ = bridge.conn.Close()
+		}
+	})
+}
+
+func (entry *liveVoiceCall) closeMedia() {
+	entry.mu.Lock()
+	bridge := entry.media
+	entry.media = nil
+	entry.mu.Unlock()
+	if bridge != nil {
+		bridge.close()
+	}
+}
+
+var _ meowcaller.AudioSource = (*voicePCMSource)(nil)
diff --git a/pkg/whatsmeow/service/voice_media_test.go b/pkg/whatsmeow/service/voice_media_test.go
new file mode 100644
index 0000000..b1c365a
--- /dev/null
+++ b/pkg/whatsmeow/service/voice_media_test.go
@@ -0,0 +1,88 @@
+package whatsmeow_service
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/patrickmn/go-cache"
+)
+
+func TestVoiceMediaActiveFramesRefreshIdleDeadline(t *testing.T) {
+	const idle = 250 * time.Millisecond
+	serverErrors := make(chan error, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		conn, err := (&websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}).Upgrade(writer, request, nil)
+		if err != nil {
+			serverErrors <- err
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetReadDeadline(time.Now().Add(idle))
+		source := &voicePCMSource{frames: make(chan []float32, 8), done: make(chan struct{})}
+		serverErrors <- readVoicePCMFrames(conn, source, idle)
+	}))
+	defer server.Close()
+	conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	for i := 0; i < 5; i++ {
+		if err := conn.WriteMessage(websocket.BinaryMessage, make([]byte, voicePCMBytes)); err != nil {
+			t.Fatalf("active frame %d: %v", i, err)
+		}
+		time.Sleep(80 * time.Millisecond)
+	}
+	if err := conn.WriteMessage(websocket.BinaryMessage, []byte{1}); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-serverErrors:
+		if err == nil || !strings.Contains(err.Error(), "invalid PCM frame") {
+			t.Fatalf("read stopped before malformed final frame: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("read loop did not process final frame")
+	}
+}
+
+func TestVoiceMediaRejectsMissingOrigin(t *testing.T) {
+	secret := strings.Repeat("s", 32)
+	claims := voiceMediaClaims{Version: 1, InstanceID: "instance", CallID: "call", Subject: "operator", ExpiresAt: time.Now().Unix() + 30, Nonce: base64.RawURLEncoding.EncodeToString([]byte("1234567890abcdef"))}
+	ticket := signedVoiceMediaTicket(t, secret, claims)
+	if _, err := verifyVoiceMediaClaims(ticket, "", secret, map[string]bool{"https://crm.example": true}, time.Now()); !errors.Is(err, ErrVoiceCallMediaInvalid) {
+		t.Fatalf("missing origin: %v", err)
+	}
+	if _, err := verifyVoiceMediaClaims(ticket, "https://crm.example", secret, map[string]bool{"https://crm.example": true}, time.Now()); err != nil {
+		t.Fatalf("valid signed ticket: %v", err)
+	}
+	used := cache.New(2*time.Minute, time.Minute)
+	if !consumeVoiceMediaNonce(used, claims) || consumeVoiceMediaNonce(used, claims) {
+		t.Fatal("media ticket nonce was not one-use")
+	}
+	claims.ExpiresAt = time.Now().Unix() - 1
+	if _, err := verifyVoiceMediaClaims(signedVoiceMediaTicket(t, secret, claims), "https://crm.example", secret, map[string]bool{"https://crm.example": true}, time.Now()); !errors.Is(err, ErrVoiceCallMediaInvalid) {
+		t.Fatalf("expired ticket: %v", err)
+	}
+}
+
+func signedVoiceMediaTicket(t *testing.T, secret string, claims voiceMediaClaims) string {
+	t.Helper()
+	data, err := json.Marshal(claims)
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded := base64.RawURLEncoding.EncodeToString(data)
+	mac := hmac.New(sha256.New, []byte(secret))
+	_, _ = mac.Write([]byte(encoded))
+	return encoded + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+}
diff --git a/pkg/whatsmeow/service/voice_recording.go b/pkg/whatsmeow/service/voice_recording.go
new file mode 100644
index 0000000..60b60ef
--- /dev/null
+++ b/pkg/whatsmeow/service/voice_recording.go
@@ -0,0 +1,227 @@
+package whatsmeow_service
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/purpshell/meowcaller"
+)
+
+// The two tracks remain private on the Evo volume until CRM retrieves them
+// with the instance API key and stores them in its private media bucket.
+type voiceRecording struct {
+	mu             sync.Mutex
+	dir            string
+	incoming       meowcaller.AudioSink
+	outgoing       meowcaller.AudioSink
+	status         string
+	incomingFrames int
+	outgoingFrames int
+	closed         bool
+}
+
+const maxVoiceRecordingFrames = 60 * 60 * 1000 / 60 // one hour, 60 ms/frame
+
+func recordingDirectory(root, instanceID, callID string) string {
+	sum := sha256.Sum256([]byte(instanceID + ":" + callID))
+	return filepath.Join(root, hex.EncodeToString(sum[:]))
+}
+
+func cleanVoiceRecordingLoop(root string, retention time.Duration) {
+	if retention < 24*time.Hour {
+		retention = 7 * 24 * time.Hour
+	}
+	cleanExpiredVoiceRecordings(root, retention, time.Now())
+	ticker := time.NewTicker(24 * time.Hour)
+	defer ticker.Stop()
+	for now := range ticker.C {
+		cleanExpiredVoiceRecordings(root, retention, now)
+	}
+}
+
+// Only the two files written by this feature are eligible for removal. The
+// CRM private bucket is the durable archive; this local volume is a seven-day
+// (or configured) retry window for asynchronous CRM ingestion.
+func cleanExpiredVoiceRecordings(root string, retention time.Duration, now time.Time) {
+	if retention < 24*time.Hour {
+		return
+	}
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		return
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		if !entry.IsDir() || len(name) != sha256.Size*2 {
+			continue
+		}
+		if _, err := hex.DecodeString(name); err != nil {
+			continue
+		}
+		dir := filepath.Join(root, name)
+		info, err := entry.Info()
+		if err != nil {
+			continue
+		}
+		latest := info.ModTime()
+		for _, channel := range []string{"incoming", "outgoing"} {
+			if file, statErr := os.Lstat(filepath.Join(dir, channel+".wav")); statErr == nil && file.ModTime().After(latest) {
+				latest = file.ModTime()
+			}
+		}
+		if now.Sub(latest) < retention {
+			continue
+		}
+		for _, channel := range []string{"incoming", "outgoing"} {
+			_ = os.Remove(filepath.Join(dir, channel+".wav"))
+		}
+		_ = os.Remove(dir)
+	}
+}
+
+func (entry *liveVoiceCall) openRecording() {
+	root := entry.manager.service.config.CallsRecordingDir
+	dir := recordingDirectory(root, entry.manager.runtime.instanceId, entry.view.CallID)
+	recording := &voiceRecording{dir: dir, status: "failed"}
+	if err := os.MkdirAll(dir, 0700); err == nil {
+		incomingPath := filepath.Join(dir, "incoming.wav")
+		outgoingPath := filepath.Join(dir, "outgoing.wav")
+		incoming, inErr := meowcaller.WAVRecorder(incomingPath)
+		outgoing, outErr := meowcaller.WAVRecorder(outgoingPath)
+		if inErr == nil && outErr == nil {
+			_ = os.Chmod(incomingPath, 0600)
+			_ = os.Chmod(outgoingPath, 0600)
+			recording.incoming = incoming
+			recording.outgoing = outgoing
+			recording.status = "recording"
+		} else {
+			if incoming != nil {
+				_ = incoming.Close()
+			}
+			if outgoing != nil {
+				_ = outgoing.Close()
+			}
+		}
+	}
+	entry.mu.Lock()
+	entry.recording = recording
+	entry.mu.Unlock()
+}
+
+func (recording *voiceRecording) write(channel string, frame []float32) {
+	if recording == nil {
+		return
+	}
+	recording.mu.Lock()
+	defer recording.mu.Unlock()
+	if recording.closed || recording.status != "recording" {
+		return
+	}
+	var sink meowcaller.AudioSink
+	if channel == "incoming" {
+		if recording.incomingFrames >= maxVoiceRecordingFrames {
+			recording.status = "partial"
+			return
+		}
+		sink = recording.incoming
+	} else {
+		if recording.outgoingFrames >= maxVoiceRecordingFrames {
+			recording.status = "partial"
+			return
+		}
+		sink = recording.outgoing
+	}
+	if sink == nil || sink.WriteFrame(frame) != nil {
+		recording.status = "partial"
+		return
+	}
+	if channel == "incoming" {
+		recording.incomingFrames++
+	} else {
+		recording.outgoingFrames++
+	}
+}
+
+func (entry *liveVoiceCall) finishRecording() {
+	entry.mu.Lock()
+	recording := entry.recording
+	entry.mu.Unlock()
+	if recording == nil {
+		return
+	}
+	recording.mu.Lock()
+	if recording.closed {
+		recording.mu.Unlock()
+		return
+	}
+	recording.closed = true
+	if recording.incoming != nil && recording.incoming.Close() != nil {
+		recording.status = "partial"
+	}
+	if recording.outgoing != nil && recording.outgoing.Close() != nil {
+		recording.status = "partial"
+	}
+	if recording.status == "recording" {
+		switch {
+		case recording.incomingFrames > 0 && recording.outgoingFrames > 0:
+			recording.status = "complete"
+		case recording.incomingFrames > 0 || recording.outgoingFrames > 0:
+			recording.status = "partial"
+		default:
+			recording.status = "failed"
+		}
+	}
+	status := recording.status
+	dir := recording.dir
+	recording.mu.Unlock()
+
+	channels := make([]map[string]any, 0, 2)
+	for _, channel := range []string{"incoming", "outgoing"} {
+		if info, err := os.Stat(filepath.Join(dir, channel+".wav")); err == nil && info.Mode().IsRegular() && info.Size() > 44 {
+			channels = append(channels, map[string]any{"channel": channel, "sizeBytes": info.Size(), "contentType": "audio/wav"})
+		}
+	}
+	if len(channels) != 2 && status == "complete" {
+		status = "partial"
+	}
+	entry.manager.emitRecording(entry.snapshot(), status, channels)
+}
+
+func (manager *voiceCallManager) emitRecording(view VoiceCallView, status string, channels []map[string]any) {
+	instance := manager.runtime.myClient.currentInstance()
+	if instance == nil {
+		return
+	}
+	payload, err := json.Marshal(map[string]any{
+		"event":      "CallRecording",
+		"instanceId": instance.Id, "instanceName": instance.Name, "instanceToken": instance.Token,
+		"data": map[string]any{
+			"version": 1, "callId": view.CallID, "instanceId": instance.Id,
+			"status": status, "occurredAt": time.Now().UTC().Format(time.RFC3339Nano), "channels": channels,
+		},
+	})
+	if err != nil {
+		return
+	}
+	manager.deliverVoiceWebhook(instance, "CallRecording", payload)
+}
+
+func (w *whatsmeowService) VoiceCallRecordingPath(instanceID, callID, channel string) (string, error) {
+	if w.config == nil || !w.voiceCallConfigured(instanceID) || w.config.CallsRecordingDir == "" {
+		return "", ErrVoiceCallsDisabled
+	}
+	if callID == "" || len(callID) > 128 || (channel != "incoming" && channel != "outgoing") {
+		return "", ErrVoiceCallNotFound
+	}
+	path := filepath.Join(recordingDirectory(w.config.CallsRecordingDir, instanceID, callID), channel+".wav")
+	info, err := os.Stat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() <= 44 {
+		return "", ErrVoiceCallNotFound
+	}
+	return path, nil
+}
