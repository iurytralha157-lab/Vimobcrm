+// UpdateConnectionSettings deliberately uses UPDATE-only semantics. GORM Save
+// falls back to INSERT when the row was concurrently deleted, which could
+// resurrect an instance after a terminal delete completed.
+func (i *instanceRepository) UpdateConnectionSettings(instance *instance_model.Instance) error {
+	result := i.db.Model(&instance_model.Instance{}).
+		Where("id = ?", instance.Id).
+		Updates(map[string]interface{}{
+			"events":            instance.Events,
+			"webhook":           instance.Webhook,
+			"rabbitmq_enable":   instance.RabbitmqEnable,
+			"nats_enable":       instance.NatsEnable,
+			"web_socket_enable": instance.WebSocketEnable,
+		})
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected != 1 {
+		return fmt.Errorf("instance %s no longer exists", instance.Id)
+	}
+	return nil
+}
