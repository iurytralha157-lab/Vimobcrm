+	if err := gate.publishRuntime(runtime, epoch); err != nil {
+		t.Fatal(err)
+	}
+	service := whatsmeowService{instanceStartGate: gate}
+
+	releaseStart, err := gate.lockStart("instance-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !service.detachRuntimeLocked(runtime) {
+		releaseStart()
+		t.Fatal("current runtime was not detached")
+	}
+	if !client.IsConnected() {
+		releaseStart()
+		t.Fatal("detach performed client teardown while the start lock was held")
+	}
+	if _, ok := gate.currentRuntime("instance-a"); ok {
+		releaseStart()
+		t.Fatal("detached runtime remained in the registry")
+	}
+	releaseStart()
+
+	teardownRuntime(runtime)
+	if client.IsConnected() {
+		t.Fatal("client remained connected after out-of-lock teardown")
+	}
+	// Cleanup can be reached from multiple shutdown paths; it must remain safe
+	// and idempotent after the first client-owned teardown.
+	teardownRuntime(runtime)
+}
