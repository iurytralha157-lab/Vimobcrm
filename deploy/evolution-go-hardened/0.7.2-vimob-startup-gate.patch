+	presenceDone := make(chan struct{})
+	go func() {
+		defer close(presenceDone)
+		<-presenceCtx.Done()
+	}()
+
+	var cancelMu sync.Mutex
+	cancelCalls := 0
+	runtime.presenceCancel = func() {
+		cancelMu.Lock()
+		cancelCalls++
+		cancelMu.Unlock()
+		cancelPresence()
+	}
+
+	const callers = 16
+	var callersDone sync.WaitGroup
+	callersDone.Add(callers)
+	for range callers {
+		go func() {
+			defer callersDone.Done()
+			runtime.requestStop()
+		}()
+	}
+	callersDone.Wait()
+
+	select {
+	case <-presenceDone:
+	case <-time.After(time.Second):
+		t.Fatal("presence worker leaked after runtime stop")
+	}
+	cancelMu.Lock()
+	gotCancelCalls := cancelCalls
+	cancelMu.Unlock()
+	if gotCancelCalls != 1 {
+		t.Fatalf("presence cancel calls = %d, want 1", gotCancelCalls)
+	}
+	runtime.presenceMu.Lock()
+	presenceCancel := runtime.presenceCancel
+	runtime.presenceMu.Unlock()
+	if presenceCancel != nil {
+		t.Fatal("presence cancel function remained retained after stop")
+	}
+	select {
+	case <-runtime.stop:
+	default:
+		t.Fatal("runtime stop was not broadcast")
+	}
