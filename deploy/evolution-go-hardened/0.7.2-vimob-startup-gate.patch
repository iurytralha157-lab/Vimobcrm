+func (g *instanceStartGate) whileAuthorized(ctx context.Context, instanceId string, expectedClient *whatsmeow.Client, requireAuthorization bool, fn func(context.Context) error) error {
+	permit, ok := g.permit(instanceId, false)
+	if !ok {
+		return ErrInstanceStartBlocked
+	}
+	permit.connectMu.Lock()
+	defer permit.connectMu.Unlock()
+
+	permit.mu.Lock()
+	runtime := permit.runtime
+	if runtime == nil || runtime.client != expectedClient || runtime.generation != permit.runtimeSequence {
+		permit.mu.Unlock()
+		return ErrRuntimeGenerationOwnership
+	}
+	if runtime.authorizationEpoch != permit.authorizationEpoch || (requireAuthorization && !permit.authorized) {
+		permit.mu.Unlock()
+		return ErrInstanceStartBlocked
+	}
+	if permit.connectionCancel != nil {
+		permit.connectionCancel()
+		permit.connectionCancel = nil
+	}
+	leaseCtx, cancel := context.WithCancel(ctx)
+	lease := &instanceConnectLease{
+		authorizationEpoch: permit.authorizationEpoch,
+		runtime:            runtime,
+		cancel:             cancel,
+	}
+	lease.timer = time.AfterFunc(authorizedConnectTimeout, cancel)
+	permit.activeLease = lease
+	permit.mu.Unlock()
+
+	err := fn(leaseCtx)
+	lease.timer.Stop()
+	if err == nil && leaseCtx.Err() != nil {
+		err = leaseCtx.Err()
+	}
+
+	permit.mu.Lock()
+	runtimeOwned := permit.runtime == lease.runtime && lease.runtime.generation == permit.runtimeSequence
+	runtimeCurrent := runtimeOwned && lease.runtime.authorizationEpoch == permit.authorizationEpoch
+	authorizationCurrent := !requireAuthorization || (permit.authorized && permit.authorizationEpoch == lease.authorizationEpoch)
+	valid := runtimeCurrent && authorizationCurrent && permit.activeLease == lease
+	if permit.activeLease == lease {
+		permit.activeLease = nil
+	}
+	if valid && err == nil {
+		permit.connectionCancel = cancel
+	} else {
+		cancel()
+	}
+	permit.mu.Unlock()
+
+	if !valid {
+		if !runtimeOwned {
+			return ErrRuntimeGenerationOwnership
+		}
+		return ErrInstanceStartBlocked
+	}
+	return err
+}
