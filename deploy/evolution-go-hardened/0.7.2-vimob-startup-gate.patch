+// setWhatsmeowClientState gives readiness tests deterministic transport and
+// authentication state without opening a real WhatsApp websocket. Those fields
+// are intentionally private in whatsmeow, so the unsafe access stays isolated
+// in this test-only helper.
+func setWhatsmeowClientState(t *testing.T, client *whatsmeow.Client, connected, loggedIn bool) {
+	t.Helper()
+	clientValue := reflect.ValueOf(client).Elem()
+	loggedInField := clientValue.FieldByName("isLoggedIn")
+	if !loggedInField.IsValid() || !loggedInField.CanAddr() {
+		t.Fatal("whatsmeow.Client.isLoggedIn is unavailable")
+	}
+	(*atomic.Bool)(unsafe.Pointer(loggedInField.UnsafeAddr())).Store(loggedIn)
+	if !connected {
+		return
+	}
+
+	frame := socket.NewFrameSocket(nil, nil)
+	frameValue := reflect.ValueOf(frame).Elem()
+	connectionField := frameValue.FieldByName("conn")
+	if !connectionField.IsValid() || !connectionField.CanAddr() {
+		t.Fatal("socket.FrameSocket.conn is unavailable")
+	}
+	(*atomic.Pointer[websocket.Conn])(unsafe.Pointer(connectionField.UnsafeAddr())).Store(&websocket.Conn{})
+
+	noise := &socket.NoiseSocket{}
+	setPrivateTestField(t, noise, "fs", frame)
+	noiseValue := reflect.ValueOf(noise).Elem()
+	destroyedField := noiseValue.FieldByName("destroyed")
+	if !destroyedField.IsValid() || !destroyedField.CanAddr() {
+		t.Fatal("socket.NoiseSocket.destroyed is unavailable")
+	}
+	// Keep Disconnect deterministic: the synthetic websocket only exists so
+	// IsConnected can observe transport state and must never be closed as a real
+	// network connection.
+	(*atomic.Bool)(unsafe.Pointer(destroyedField.UnsafeAddr())).Store(true)
+	setPrivateTestField(t, client, "socket", noise)
+}
+
+func setPrivateTestField(t *testing.T, target any, name string, value any) {
+	t.Helper()
+	field := reflect.ValueOf(target).Elem().FieldByName(name)
+	if !field.IsValid() || !field.CanAddr() {
+		t.Fatalf("private field %s is unavailable", name)
+	}
+	writable := reflect.NewAt(field.Type(), unsafe.Pointer(field.UnsafeAddr())).Elem()
+	writable.Set(reflect.ValueOf(value))
+}
