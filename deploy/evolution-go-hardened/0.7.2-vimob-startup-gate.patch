+package instance_repository
+
+import (
+	"database/sql/driver"
+	"fmt"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/DATA-DOG/go-sqlmock"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+
+	instance_model "github.com/evolution-foundation/evolution-go/pkg/instance/model"
+)
+
+func newConnectionSettingsTestRepository(t *testing.T) (*instanceRepository, sqlmock.Sqlmock) {
+	t.Helper()
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	gormDB, err := gorm.Open(postgres.New(postgres.Config{Conn: db}), &gorm.Config{SkipDefaultTransaction: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &instanceRepository{db: gormDB}, mock
+}
+
+func TestUpdateConnectionSettingsUsesUpdateOnlyAndRequiresExistingRow(t *testing.T) {
+	instance := &instance_model.Instance{
+		Id:              "0cac3301-cf94-4105-b07a-b75f9ce8e9ed",
+		Events:          "Message",
+		Webhook:         "https://example.invalid/webhook",
+		RabbitmqEnable:  "false",
+		NatsEnable:      "false",
+		WebSocketEnable: "false",
+	}
+	query := regexp.QuoteMeta(`UPDATE "instances" SET "events"=$1,"nats_enable"=$2,"rabbitmq_enable"=$3,"web_socket_enable"=$4,"webhook"=$5 WHERE id = $6`)
+	args := []driver.Value{instance.Events, instance.NatsEnable, instance.RabbitmqEnable, instance.WebSocketEnable, instance.Webhook, instance.Id}
+
+	for _, test := range []struct {
+		name         string
+		rowsAffected int64
+		wantError    string
+	}{
+		{name: "existing row", rowsAffected: 1},
+		{name: "deleted row", rowsAffected: 0, wantError: "no longer exists"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			repository, mock := newConnectionSettingsTestRepository(t)
+			mock.ExpectExec(query).WithArgs(args...).WillReturnResult(sqlmock.NewResult(0, test.rowsAffected))
+
+			err := repository.UpdateConnectionSettings(instance)
+			if test.wantError == "" && err != nil {
+				t.Fatalf("UpdateConnectionSettings error = %v, want nil", err)
+			}
+			if test.wantError != "" && (err == nil || !strings.Contains(err.Error(), test.wantError)) {
+				t.Fatalf("UpdateConnectionSettings error = %v, want substring %q", err, test.wantError)
+			}
+			if err := mock.ExpectationsWereMet(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestUpdateProxyUsesUpdateOnlyAndRequiresExistingRow(t *testing.T) {
+	query := regexp.QuoteMeta(`UPDATE "instances" SET "proxy"=$1 WHERE id = $2`)
+	for _, test := range []struct {
+		name         string
+		rowsAffected int64
+		wantError    string
+	}{
+		{name: "existing row", rowsAffected: 1},
+		{name: "deleted row", rowsAffected: 0, wantError: "no longer exists"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			repository, mock := newConnectionSettingsTestRepository(t)
+			mock.ExpectExec(query).
+				WithArgs("http://proxy.invalid:8080", "instance-a").
+				WillReturnResult(sqlmock.NewResult(0, test.rowsAffected))
+
+			err := repository.UpdateProxy("instance-a", "http://proxy.invalid:8080")
+			if test.wantError == "" && err != nil {
+				t.Fatalf("UpdateProxy error = %v, want nil", err)
+			}
+			if test.wantError != "" && (err == nil || !strings.Contains(err.Error(), test.wantError)) {
+				t.Fatalf("UpdateProxy error = %v, want substring %q", err, test.wantError)
+			}
+			if err := mock.ExpectationsWereMet(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestLifecycleUpdatesRequireExistingInstance(t *testing.T) {
+	const instanceID = "0cac3301-cf94-4105-b07a-b75f9ce8e9ed"
+	tests := []struct {
+		name  string
+		query string
+		args  []driver.Value
+		call  func(*instanceRepository) error
+	}{
+		{
+			name:  "connected",
+			query: `UPDATE "instances" SET "connected"=$1,"disconnect_reason"=$2 WHERE id = $3`,
+			args:  []driver.Value{true, "", instanceID},
+			call: func(repository *instanceRepository) error {
+				return repository.UpdateConnected(instanceID, true, "")
+			},
+		},
+		{
+			name:  "events",
+			query: `UPDATE "instances" SET "events"=$1 WHERE id = $2`,
+			args:  []driver.Value{"Message", instanceID},
+			call: func(repository *instanceRepository) error {
+				return repository.UpdateEvents(instanceID, "Message")
+			},
+		},
+		{
+			name:  "qrcode",
+			query: `UPDATE "instances" SET "qrcode"=$1 WHERE id = $2`,
+			args:  []driver.Value{"qr-value", instanceID},
+			call: func(repository *instanceRepository) error {
+				return repository.UpdateQrcode(instanceID, "qr-value")
+			},
+		},
+		{
+			name:  "jid",
+			query: `UPDATE "instances" SET "jid"=$1 WHERE id = $2`,
+			args:  []driver.Value{"5511999999999:1@s.whatsapp.net", instanceID},
+			call: func(repository *instanceRepository) error {
+				return repository.UpdateJid(instanceID, "5511999999999:1@s.whatsapp.net")
+			},
+		},
+		{
+			name:  "pair state",
+			query: `UPDATE "instances" SET "connected"=$1,"disconnect_reason"=$2,"jid"=$3,"qrcode"=$4 WHERE id = $5`,
+			args:  []driver.Value{true, "", "5511999999999:1@s.whatsapp.net", "", instanceID},
+			call: func(repository *instanceRepository) error {
+				return repository.UpdatePairState(instanceID, "5511999999999:1@s.whatsapp.net")
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			for _, rowsAffected := range []int64{1, 0} {
+				wantError := rowsAffected == 0
+				t.Run(fmt.Sprintf("rows_%d", rowsAffected), func(t *testing.T) {
+					repository, mock := newConnectionSettingsTestRepository(t)
+					mock.ExpectExec(regexp.QuoteMeta(test.query)).
+						WithArgs(test.args...).
+						WillReturnResult(sqlmock.NewResult(0, rowsAffected))
+
+					err := test.call(repository)
+					if !wantError && err != nil {
+						t.Fatalf("lifecycle update error = %v, want nil", err)
+					}
+					if wantError && (err == nil || !strings.Contains(err.Error(), "no longer exists")) {
+						t.Fatalf("lifecycle update error = %v, want missing-row error", err)
+					}
+					if err := mock.ExpectationsWereMet(); err != nil {
+						t.Fatal(err)
+					}
+				})
+			}
+		})
+	}
+}
