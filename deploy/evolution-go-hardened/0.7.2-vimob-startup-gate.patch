+func TestSetupLeaseIsBoundedAndSupersededSafely(t *testing.T) {
+	gate := newInstanceStartGate()
+	epoch := gate.authorize("instance-a")
+	firstCtx, finishFirst, err := gate.beginSetup("instance-a", epoch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	deadline, ok := firstCtx.Deadline()
+	if !ok {
+		t.Fatal("setup lease has no timeout")
+	}
+	remaining := time.Until(deadline)
+	if remaining <= 0 || remaining > authorizedSetupTimeout {
+		t.Fatalf("setup lease timeout = %v, want (0, %v]", remaining, authorizedSetupTimeout)
+	}
+
+	secondCtx, finishSecond, err := gate.beginSetup("instance-a", epoch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-firstCtx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("replacement setup lease did not cancel its predecessor")
+	}
+	permit, _ := gate.permit("instance-a", false)
+	permit.mu.Lock()
+	secondLease := permit.setupLease
+	permit.mu.Unlock()
+	if secondLease == nil {
+		t.Fatal("replacement setup lease was not installed")
+	}
+
+	finishFirst()
+	permit.mu.Lock()
+	currentLease := permit.setupLease
+	permit.mu.Unlock()
+	if currentLease != secondLease {
+		t.Fatal("stale setup completion cleared the replacement lease")
+	}
+
+	finishSecond()
+	select {
+	case <-secondCtx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("finishing setup did not cancel the lease context")
+	}
+	permit.mu.Lock()
+	currentLease = permit.setupLease
+	permit.mu.Unlock()
+	if currentLease != nil {
+		t.Fatal("finished setup lease remained installed")
+	}
+}
