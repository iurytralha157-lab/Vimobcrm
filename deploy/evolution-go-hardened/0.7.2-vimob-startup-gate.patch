+	permit.mu.Lock()
+	valid := permit.terminal == nil && permit.authorized && permit.runtime == runtime &&
+		runtime.generation == permit.runtimeSequence &&
+		runtime.authorizationEpoch == permit.authorizationEpoch &&
+		runtime.client.IsConnected() && runtime.client.IsLoggedIn()
+	if !valid {
+		permit.mu.Unlock()
+		return false
+	}
+	runtime.readyOnce.Do(func() {
+		close(runtime.ready)
+	})
