+		}
+	case <-time.After(time.Second):
+		t.Fatal("revoke did not cancel the in-flight connect")
+	}
+
+	called := false
+	err := gate.whileAuthorized(context.Background(), "instance-a", client, true, func(context.Context) error {
+		called = true
+		return nil
+	})
+	if !errors.Is(err, ErrInstanceStartBlocked) {
