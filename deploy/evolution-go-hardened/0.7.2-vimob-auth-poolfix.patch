+package whatsmeow_service
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	_ "modernc.org/sqlite"
+
+	"github.com/evolution-foundation/evolution-go/pkg/config"
+)
+
+// Validate the shared auth container contract without an external database:
+// a failed initialization is retried, while the first success is reused.
+func TestGetAuthContainerRetryAndReuse(t *testing.T) {
+	sharedAuthContainerMu.Lock()
+	sharedAuthContainer = nil
+	sharedAuthContainerMu.Unlock()
+
+	t.Cleanup(func() {
+		sharedAuthContainerMu.Lock()
+		sharedAuthContainer = nil
+		sharedAuthContainerMu.Unlock()
+	})
+
+	bad := whatsmeowService{
+		config: &config.Config{},
+		exPath: filepath.Join(t.TempDir(), "does-not-exist"),
+	}
+	if container, err := bad.getAuthContainer(); err == nil || container != nil {
+		t.Fatalf("expected failed initialization to return (nil, error), got (%p, %v)", container, err)
+	}
+	sharedAuthContainerMu.Lock()
+	poisoned := sharedAuthContainer != nil
+	sharedAuthContainerMu.Unlock()
+	if poisoned {
+		t.Fatal("failed initialization must not be memoized")
+	}
+
+	goodPath := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(goodPath, "dbdata"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	good := whatsmeowService{
+		config: &config.Config{},
+		exPath: goodPath,
+	}
+	c1, err := good.getAuthContainer()
+	if err != nil {
+		t.Fatalf("retry after failure should succeed: %v", err)
+	}
+	if c1 == nil {
+		t.Fatal("successful initialization returned a nil container")
+	}
+	t.Cleanup(func() { _ = c1.Close() })
+
+	c2, err := good.getAuthContainer()
+	if err != nil {
+		t.Fatalf("second call failed: %v", err)
+	}
+	if c1 != c2 {
+		t.Fatal("successful auth container was not reused")
+	}
+}
