new file mode 100644
index 0000000..8ffb945
--- /dev/null
+++ b/pkg/whatsmeow/service/handshake_version_test.go
@@ -0,0 +1,137 @@
+package whatsmeow_service
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/evolution-foundation/evolution-go/pkg/config"
+	instance_model "github.com/evolution-foundation/evolution-go/pkg/instance/model"
+	"go.mau.fi/whatsmeow/store"
+	"google.golang.org/protobuf/proto"
+)
+
+type versionRoundTripper func(*http.Request) (*http.Response, error)
+
+func (roundTrip versionRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	return roundTrip(request)
+}
+
+func resetVersionStateForTest(t *testing.T) {
+	t.Helper()
+	oldVersion := store.GetWAVersion()
+	oldProps := proto.Clone(store.DeviceProps)
+	oldInitialized := devicePropsInitialized
+	oldCached, oldCachedAt := cachedWebVersion, cachedWebVersionAt
+	oldTransport := http.DefaultTransport
+	devicePropsInitialized = false
+	cachedWebVersion = nil
+	t.Cleanup(func() {
+		store.SetWAVersion(oldVersion)
+		proto.Reset(store.DeviceProps)
+		proto.Merge(store.DeviceProps, oldProps)
+		devicePropsInitialized = oldInitialized
+		cachedWebVersion, cachedWebVersionAt = oldCached, oldCachedAt
+		http.DefaultTransport = oldTransport
+	})
+}
+
+func assertHandshakeVersion(t *testing.T, expected store.WAVersionContainer) {
+	t.Helper()
+	if actual := store.GetWAVersion(); actual != expected {
+		t.Fatalf("handshake version = %v, want %v", actual, expected)
+	}
+	if !proto.Equal(store.BaseClientPayload.UserAgent.AppVersion, expected.ProtoAppVersion()) {
+		t.Fatal("UserAgent handshake app version was not updated")
+	}
+}
+
+func TestInitializeDevicePropsUpdatesConfiguredHandshakeVersion(t *testing.T) {
+	resetVersionStateForTest(t)
+	service := whatsmeowService{config: &config.Config{
+		WhatsappVersionMajor: 2, WhatsappVersionMinor: 3000, WhatsappVersionPatch: 1052855845,
+	}}
+	if err := service.initializeDeviceProps(context.Background(), &instance_model.Instance{OsName: "Synthetic"}); err != nil {
+		t.Fatal(err)
+	}
+	expected := store.WAVersionContainer{2, 3000, 1052855845}
+	assertHandshakeVersion(t, expected)
+	service.config.WhatsappVersionPatch++
+	if err := service.initializeDeviceProps(context.Background(), nil); err != nil {
+		t.Fatal(err)
+	}
+	assertHandshakeVersion(t, expected)
+}
+
+func TestInitializeDevicePropsDiscoversVersionFromWhatsAppRoot(t *testing.T) {
+	resetVersionStateForTest(t)
+	requests := 0
+	http.DefaultTransport = versionRoundTripper(func(request *http.Request) (*http.Response, error) {
+		requests++
+		if request.Method != http.MethodGet || request.URL.String() != "https://web.whatsapp.com" {
+			t.Fatalf("unexpected discovery request: %s %s", request.Method, request.URL)
+		}
+		if request.Header.Get("Sec-Fetch-Mode") != "navigate" {
+			t.Fatal("official browser request headers are missing")
+		}
+		return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(`{"client_revision":1052855845,}`))}, nil
+	})
+	service := whatsmeowService{config: &config.Config{}}
+	if err := service.initializeDeviceProps(context.Background(), nil); err != nil {
+		t.Fatal(err)
+	}
+	assertHandshakeVersion(t, store.WAVersionContainer{2, 3000, 1052855845})
+	if err := service.initializeDeviceProps(context.Background(), nil); err != nil {
+		t.Fatal(err)
+	}
+	if requests != 1 {
+		t.Fatalf("discovery requests = %d, want 1", requests)
+	}
+}
+
+func TestInitializeDevicePropsDoesNotCommitCanceledInitialization(t *testing.T) {
+	resetVersionStateForTest(t)
+	before := store.GetWAVersion()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	service := whatsmeowService{config: &config.Config{}}
+	if err := service.initializeDeviceProps(ctx, nil); !errors.Is(err, context.Canceled) {
+		t.Fatalf("error = %v, want context cancellation", err)
+	}
+	if devicePropsInitialized {
+		t.Fatal("canceled initialization was committed")
+	}
+	assertHandshakeVersion(t, before)
+}
+
+func TestInitializeDevicePropsRetriesAfterDiscoveryFailure(t *testing.T) {
+	resetVersionStateForTest(t)
+	before := store.GetWAVersion()
+	requests := 0
+	wantError := errors.New("synthetic discovery failure")
+	http.DefaultTransport = versionRoundTripper(func(request *http.Request) (*http.Response, error) {
+		requests++
+		if requests == 1 {
+			return nil, wantError
+		}
+		return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(`{"client_revision":1052855845,}`))}, nil
+	})
+	service := whatsmeowService{config: &config.Config{}}
+	if err := service.initializeDeviceProps(context.Background(), nil); !errors.Is(err, wantError) {
+		t.Fatalf("error = %v, want discovery failure", err)
+	}
+	if devicePropsInitialized {
+		t.Fatal("failed discovery was committed")
+	}
+	assertHandshakeVersion(t, before)
+	if err := service.initializeDeviceProps(context.Background(), nil); err != nil {
+		t.Fatal(err)
+	}
+	assertHandshakeVersion(t, store.WAVersionContainer{2, 3000, 1052855845})
+	if requests != 2 {
+		t.Fatalf("discovery requests = %d, want 2", requests)
+	}
+}
