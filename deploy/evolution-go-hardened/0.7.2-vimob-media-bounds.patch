+type boundedMediaFile struct {
+	file       *os.File
+	maxSize    int64
+	cancel     context.CancelFunc
+	overflowed bool
+}
+
+func (f *boundedMediaFile) rejectOverflow() error {
+	f.overflowed = true
+	if f.cancel != nil {
+		f.cancel()
+	}
+	return ErrDownloadMediaSizeRejected
+}
+
+func (f *boundedMediaFile) Read(p []byte) (int, error)              { return f.file.Read(p) }
+func (f *boundedMediaFile) ReadAt(p []byte, off int64) (int, error) { return f.file.ReadAt(p, off) }
+func (f *boundedMediaFile) Seek(offset int64, whence int) (int64, error) {
+	return f.file.Seek(offset, whence)
+}
+func (f *boundedMediaFile) Stat() (os.FileInfo, error) { return f.file.Stat() }
+
+func (f *boundedMediaFile) Write(p []byte) (int, error) {
+	offset, err := f.file.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return 0, err
+	}
+	if offset < 0 || offset > f.maxSize {
+		return 0, f.rejectOverflow()
+	}
+	if int64(len(p)) > f.maxSize-offset {
+		allowed := f.maxSize - offset
+		if allowed > 0 {
+			n, writeErr := f.file.Write(p[:allowed])
+			if writeErr != nil {
+				return n, writeErr
+			}
+			return n, f.rejectOverflow()
+		}
+		return 0, f.rejectOverflow()
+	}
+	return f.file.Write(p)
+}
+
+func (f *boundedMediaFile) WriteAt(p []byte, off int64) (int, error) {
+	if off < 0 || off > f.maxSize || int64(len(p)) > f.maxSize-off {
+		return 0, f.rejectOverflow()
+	}
+	return f.file.WriteAt(p, off)
+}
+
+func (f *boundedMediaFile) Truncate(size int64) error {
+	if size < 0 || size > f.maxSize {
+		return f.rejectOverflow()
+	}
+	return f.file.Truncate(size)
+}
+
+func selectDownloadableMedia(msg *waE2E.Message) (whatsmeow.DownloadableMessage, string, uint64, error) {
+	if msg == nil {
+		return nil, "", 0, errors.New("message is required")
+	}
+
+	type candidate struct {
+		media    whatsmeow.DownloadableMessage
+		mimetype string
+		size     uint64
+	}
+	candidates := make([]candidate, 0, 1)
+	if media := msg.GetImageMessage(); media != nil {
+		candidates = append(candidates, candidate{media, media.GetMimetype(), media.GetFileLength()})
+	}
+	if media := msg.GetAudioMessage(); media != nil {
+		candidates = append(candidates, candidate{media, media.GetMimetype(), media.GetFileLength()})
+	}
+	if media := msg.GetDocumentMessage(); media != nil {
+		candidates = append(candidates, candidate{media, media.GetMimetype(), media.GetFileLength()})
+	}
+	if media := msg.GetVideoMessage(); media != nil {
+		candidates = append(candidates, candidate{media, media.GetMimetype(), media.GetFileLength()})
+	}
+	if media := msg.GetStickerMessage(); media != nil {
+		candidates = append(candidates, candidate{media, media.GetMimetype(), media.GetFileLength()})
+	}
+	if len(candidates) != 1 {
+		return nil, "", 0, fmt.Errorf("message must contain exactly one downloadable media payload, got %d", len(candidates))
+	}
+	selected := candidates[0]
+	return selected.media, selected.mimetype, selected.size, nil
+}
+
+func normalizeDownloadMediaMIME(value string) string {
+	parsed, _, err := mime.ParseMediaType(strings.TrimSpace(value))
+	if err != nil {
+		return "application/octet-stream"
+	}
+	parts := strings.Split(parsed, "/")
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return "application/octet-stream"
+	}
+	return strings.ToLower(parsed)
+}
+
+func downloadMediaBounded(ctx context.Context, cancel context.CancelFunc, client *whatsmeow.Client, media whatsmeow.DownloadableMessage) ([]byte, error) {
+	tempFile, err := os.CreateTemp("", "evolution-go-media-*")
+	if err != nil {
+		return nil, fmt.Errorf("failed to create bounded media file: %w", err)
+	}
+	name := tempFile.Name()
+	defer func() {
+		_ = tempFile.Close()
+		_ = os.Remove(name)
+	}()
+
+	bounded := &boundedMediaFile{
+		file:    tempFile,
+		maxSize: downloadMediaTransportMaxBytes,
+		cancel:  cancel,
+	}
+	if err := client.DownloadToFile(ctx, media, bounded); err != nil {
+		if bounded.overflowed {
+			return nil, fmt.Errorf("%w: transport exceeded %d bytes", ErrDownloadMediaSizeRejected, downloadMediaTransportMaxBytes)
+		}
+		return nil, err
+	}
+
+	stat, err := tempFile.Stat()
+	if err != nil {
+		return nil, fmt.Errorf("failed to inspect downloaded media: %w", err)
+	}
+	if stat.Size() <= 0 || stat.Size() > downloadMediaMaxBytes {
+		return nil, fmt.Errorf("%w: downloaded size must be between 1 and %d bytes", ErrDownloadMediaSizeRejected, downloadMediaMaxBytes)
+	}
+	if _, err := tempFile.Seek(0, io.SeekStart); err != nil {
+		return nil, fmt.Errorf("failed to rewind downloaded media: %w", err)
+	}
+	mediaData, err := io.ReadAll(io.LimitReader(tempFile, downloadMediaMaxBytes+1))
+	if err != nil {
+		return nil, fmt.Errorf("failed to read downloaded media: %w", err)
+	}
+	if len(mediaData) == 0 || len(mediaData) > downloadMediaMaxBytes {
+		return nil, fmt.Errorf("%w: downloaded size must be between 1 and %d bytes", ErrDownloadMediaSizeRejected, downloadMediaMaxBytes)
+	}
+	return mediaData, nil
+}
