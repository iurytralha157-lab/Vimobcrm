+package message_service
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestSelectDownloadableMediaRequiresExactlyOnePayload(t *testing.T) {
+	if _, _, _, err := selectDownloadableMedia(&waE2E.Message{}); err == nil {
+		t.Fatal("expected an empty message to be rejected")
+	}
+
+	message := &waE2E.Message{
+		AudioMessage: &waE2E.AudioMessage{
+			Mimetype:   proto.String("audio/ogg; codecs=opus"),
+			FileLength: proto.Uint64(1234),
+		},
+	}
+	media, mimetype, size, err := selectDownloadableMedia(message)
+	if err != nil {
+		t.Fatalf("single audio payload was rejected: %v", err)
+	}
+	if media != message.AudioMessage || mimetype != "audio/ogg; codecs=opus" || size != 1234 {
+		t.Fatalf("unexpected selection: media=%T mimetype=%q size=%d", media, mimetype, size)
+	}
+
+	message.ImageMessage = &waE2E.ImageMessage{
+		Mimetype:   proto.String("image/jpeg"),
+		FileLength: proto.Uint64(321),
+	}
+	if _, _, _, err := selectDownloadableMedia(message); err == nil {
+		t.Fatal("expected multiple media payloads to be rejected")
+	}
+}
+
+func TestNormalizeDownloadMediaMIME(t *testing.T) {
+	tests := map[string]string{
+		"audio/ogg; codecs=opus": "audio/ogg",
+		" IMAGE/JPEG ":           "image/jpeg",
+		"":                       "application/octet-stream",
+		"invalid":                "application/octet-stream",
+		"a/b/c":                  "application/octet-stream",
+	}
+	for input, expected := range tests {
+		if actual := normalizeDownloadMediaMIME(input); actual != expected {
+			t.Errorf("normalizeDownloadMediaMIME(%q)=%q, want %q", input, actual, expected)
+		}
+	}
+}
+
+func TestBoundedMediaFileStopsAtLimitAndCancels(t *testing.T) {
+	file, err := os.CreateTemp("", "bounded-media-test-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	name := file.Name()
+	t.Cleanup(func() {
+		_ = file.Close()
+		_ = os.Remove(name)
+	})
+
+	ctx, cancel := context.WithCancel(context.Background())
+	bounded := &boundedMediaFile{file: file, maxSize: 4, cancel: cancel}
+	n, err := bounded.Write([]byte("12345"))
+	if n != 4 || !errors.Is(err, ErrDownloadMediaSizeRejected) {
+		t.Fatalf("overflow write returned (%d, %v), want (4, size rejection)", n, err)
+	}
+	if !bounded.overflowed {
+		t.Fatal("overflow flag was not set")
+	}
+	select {
+	case <-ctx.Done():
+	default:
+		t.Fatal("overflow did not cancel the in-flight download")
+	}
+	stat, err := file.Stat()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stat.Size() != 4 {
+		t.Fatalf("bounded file grew to %d bytes, want 4", stat.Size())
+	}
+}
+
+func TestBoundedMediaFileRejectsOversizedWriteAtAndTruncate(t *testing.T) {
+	file, err := os.CreateTemp("", "bounded-media-test-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	name := file.Name()
+	t.Cleanup(func() {
+		_ = file.Close()
+		_ = os.Remove(name)
+	})
+
+	bounded := &boundedMediaFile{file: file, maxSize: 4}
+	if _, err := bounded.WriteAt([]byte("x"), 4); !errors.Is(err, ErrDownloadMediaSizeRejected) {
+		t.Fatalf("oversized WriteAt error=%v, want size rejection", err)
+	}
+	if err := bounded.Truncate(5); !errors.Is(err, ErrDownloadMediaSizeRejected) {
+		t.Fatalf("oversized Truncate error=%v, want size rejection", err)
+	}
+}
