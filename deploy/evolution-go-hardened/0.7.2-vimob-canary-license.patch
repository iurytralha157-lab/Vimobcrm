new file mode 100644
index 0000000..1999b2d
--- /dev/null
+++ b/pkg/middleware/auth_middleware_test.go
@@ -0,0 +1,52 @@
+package auth_middleware
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+type testLicenseState struct {
+	active bool
+	key    string
+}
+
+func (l testLicenseState) IsActive() bool { return l.active }
+func (l testLicenseState) APIKey() string { return l.key }
+
+func TestAdminTokenRequiresActiveLicenseAndNonEmptyKey(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name    string
+		license testLicenseState
+		token   string
+		want    int
+	}{
+		{name: "valid active key", license: testLicenseState{true, "canary-key"}, token: "canary-key", want: http.StatusOK},
+		{name: "wrong key of same length", license: testLicenseState{true, "canary-key"}, token: "canary-kex", want: http.StatusUnauthorized},
+		{name: "short prefix", license: testLicenseState{true, "canary-key"}, token: "canary-ke", want: http.StatusUnauthorized},
+		{name: "empty token", license: testLicenseState{true, "canary-key"}, want: http.StatusUnauthorized},
+		{name: "empty license key", license: testLicenseState{true, ""}, token: "canary-key", want: http.StatusUnauthorized},
+		{name: "inactive license", license: testLicenseState{false, "canary-key"}, token: "canary-key", want: http.StatusUnauthorized},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := ValidAdminToken(tc.license, tc.token); got != (tc.want == http.StatusOK) {
+				t.Fatalf("ValidAdminToken() = %v, want %v", got, tc.want == http.StatusOK)
+			}
+
+			router := gin.New()
+			router.GET("/admin", NewMiddleware(tc.license, nil).AuthAdmin, func(ctx *gin.Context) {
+				ctx.Status(http.StatusOK)
+			})
+			request := httptest.NewRequest(http.MethodGet, "/admin", nil)
+			request.Header.Set("apikey", tc.token)
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, request)
+			if response.Code != tc.want {
+				t.Fatalf("AuthAdmin status = %d, want %d", response.Code, tc.want)
+			}
+		})
+	}
+}
