+func ValidAdminToken(license LicenseState, token string) bool {
+	if license == nil || !license.IsActive() || token == "" {
+		return false
+	}
+	key := license.APIKey()
+	return key != "" && len(token) == len(key) && subtle.ConstantTimeCompare([]byte(token), []byte(key)) == 1
+}
