--- /dev/null
+++ b/pkg/config/license_bootstrap_test.go
@@ -0,0 +1,35 @@
+package config
+
+import "testing"
+
+func TestLoadAllowsOperatorEmailWithoutGlobalAPIKey(t *testing.T) {
+	t.Setenv("POSTGRES_USERS_DB", "postgres://unused:unused@localhost/unused")
+	t.Setenv("DATABASE_SAVE_MESSAGES", "false")
+	t.Setenv("GLOBAL_API_KEY", "")
+	t.Setenv("EVOLUTION_OPERATOR_EMAIL", "operator@example.com")
+	t.Setenv("AMQP_URL", "")
+	t.Setenv("MINIO_ENABLED", "false")
+
+	cfg := Load()
+	if cfg.GlobalApiKey != "" {
+		t.Fatalf("GLOBAL_API_KEY = %q, want empty for auto-activation", cfg.GlobalApiKey)
+	}
+}
+
+func TestLicenseBootstrapRequiresKeyOrOperatorEmail(t *testing.T) {
+	for _, tc := range []struct {
+		name, globalAPIKey, operatorEmail string
+		want                              bool
+	}{
+		{name: "missing both", want: false},
+		{name: "whitespace only", globalAPIKey: "  ", operatorEmail: "  ", want: false},
+		{name: "existing key", globalAPIKey: "license-key", want: true},
+		{name: "registered operator", operatorEmail: " operator@example.com ", want: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := hasLicenseBootstrapCredential(tc.globalAPIKey, tc.operatorEmail); got != tc.want {
+				t.Fatalf("hasLicenseBootstrapCredential() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
