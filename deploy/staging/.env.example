# Example only. Enter real values directly in the staging destination UI.
# Every variable belongs to homologation; never copy the production env file.
# A real .env is ignored by Git and must never be committed.

# Both images use the exact same full commit SHA printed by Staging Images.
# Prefix: ghcr.io/<lowercase-owner>/<lowercase-private-repository>
STAGING_IMAGE_PREFIX=ghcr.io/example/vimob-homologacao
STAGING_RELEASE_SHA=

# Must match the public URLs baked into the web image by the staging workflow.
STAGING_WEB_DOMAIN=homologacao.example.com
STAGING_API_DOMAIN=api-homologacao.example.com
STAGING_PUBLIC_WEB_URL=https://homologacao.example.com
STAGING_PUBLIC_API_URL=https://api-homologacao.example.com

# New, isolated Supabase project. No trailing slash on the URL.
# Public key is also used at build time; server-only key stays in Portainer.
STAGING_PROJECT_REF=
STAGING_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SECRET_KEY=
# Use the direct connection or session pooler (5432), not transaction mode (6543).
# Obtain and enter the isolated project's connection string in the destination.
STAGING_DATABASE_URL=

# Required server-only security keys, generated exclusively for staging.
# Recovery: 32-512 bytes. Billing signing: 32-512 non-whitespace bytes.
# Enter in the destination UI; never reuse production keys.
STAGING_PUBLIC_SIGNUP_RECOVERY_SECRET=
STAGING_BILLING_EDGE_CLIENT_IP_SIGNING_SECRET=
# Valid matching VAPID pair; dispatch remains disabled by the stack.
STAGING_WEB_PUSH_VAPID_PUBLIC_KEY=
STAGING_WEB_PUSH_VAPID_PRIVATE_KEY=

# Existing proxy configuration, checked on the selected staging host.
# Do not create/change DNS or networks until that deployment is authorized.
STAGING_TRAEFIK_NETWORK=
STAGING_TRAEFIK_HTTPS_ENTRYPOINT=
STAGING_TRAEFIK_CERT_RESOLVER=
STAGING_TRUSTED_PROXY_CIDRS=

# Docker Compose standalone only. The host reverse proxy must reach loopback.
# Use free, dedicated ports; docker stack deploy does not honor loopback binds.
STAGING_WEB_PORT=13000
STAGING_API_PORT=18081
